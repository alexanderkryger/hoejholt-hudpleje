{%- comment -%}
----------------------------------------------------------------------------------------------------------------------
VARIANT PICKER
----------------------------------------------------------------------------------------------------------------------

Render the variant picker option selectors.

********************************************
Supported variables
********************************************

* product: the product for which to render the selector (required)
* context: the context of the variant picker. Can be "main_product", "featured_product" or "quick_buy" (required)
* form_id: the ID of the form that is listening
* hide_sold_out_variants: if set to true, the sold out or unavailable variants are hidden
* separate_options: if set to true, consecutive options are separated by a border
* selector_style: the selector style to use for the main selectors
* swatch_selector_style: the selector style to use for the dedicated swatch selectors
* swatch_selector_size: the size for the color selectors. Can be either "sm" or "lg"
* block_selector_style: the selector style to use for the dedicated block selectors
* variant_image_options: a list of option names for which to use the variant image selector mode
* size_chart_page: the page to use for the size chart
* alignment: the content alignment for options (can be "start", "center" or "end")
{%- endcomment -%}

{%- liquid
  assign color_label_list = 'general.label.color' | t | replace: ', ', ',' | downcase | split: ','
  assign size_label_list = 'general.label.size' | t | replace: ', ', ',' | downcase | split: ','
  assign variant_image_options = variant_image_options | replace: ', ', ',' | downcase | split: ','

  if context == 'main_product'
    assign is_main_product = true
  endif
-%}

{%- unless product.has_only_default_variant -%}
  <variant-picker class="variant-picker" section-id="{{ section.id }}" form-id="{{ form_id }}" handle="{{ product.handle }}" {% if is_main_product %}update-url{% endif %}>
    {%- comment -%}
    The variant data is outputted as a JSON, which allows the theme to emit an event with the data when the variant changes. This must not be removed.
    {%- endcomment -%}
    <script data-variant type="application/json">
      {{- product.selected_or_first_available_variant | json -}}
    </script>
    
    {%- for option in product.options_with_values -%}
      {% liquid
        assign option_downcase = option.name | downcase
        assign resolved_option_selector_style = selector_style

        assign swatch_count = option.values | map: 'swatch' | compact | size

        if swatch_count > 0 and swatch_selector_style != 'none'
          # Use the swatch selector type only if we have at least one swatch and a supported swatch selector type
          assign resolved_option_selector_style = swatch_selector_style
        endif

        # Implementation note: if the option value has no native swatch, BUT that the option name matches a hardcoded list of color names,
        # we fallback to the legacy config-based system. This allows to keep compatibility with stores that were using the config-based, and
        # allow those merchants to upgrade to the new system at their own pace.
        if swatch_count == 0 and color_label_list contains option_downcase and swatch_selector_style != 'none'
          assign resolved_option_selector_style = swatch_selector_style
        endif

        if variant_image_options contains option_downcase
          assign resolved_option_selector_style = 'variant_image'
        endif
      %}

      <fieldset class="variant-picker__option justify-{{ alignment }}">
        <div class="variant-picker__option-info {% if alignment == 'start' %}justify-between{% else %}justify-{{ alignment }}{% endif %}">
          <div class="h-stack gap-2">
            <legend class="text-subdued">{{ option.name }}:</legend>
            <span>{{ option.selected_value }}</span>
          </div>

          {%- if size_chart_page != blank and size_label_list contains option_downcase -%}
            {%- capture id -%}size-chart-{{ section.id }}-{{ block.id }}{%- endcapture -%}

            <button type="button" class="link subheading" aria-controls="{{ id | escape }}" aria-expanded="false">
              {{- 'product.general.size_chart' | t -}}
            </button>

            <x-drawer id="{{ id | escape }}" class="drawer color-scheme color-scheme--{{ settings.default_color_scheme.id }}">
              <span class="h5" slot="header">{{ size_chart_page.title }}</span>

              <div class="prose">
                {{- size_chart_page.content -}}
              </div>
            </x-drawer>
          {%- endif -%}
        </div>

        {%- if hide_single_value_options and option.values.size == 1 -%}
          {%- liquid
            assign param_name = form_id | append: '-option' | append: option.position
            assign single_option_value = option.values | first
          -%}

          <input class="sr-only" type="radio" id="{{ param_name }}-{{ single_option_value.id }}" form="{{ form_id }}" name="{{ param_name }}" data-option-position="{{ option.position }}" value="{{ single_option_value.id }}" checked>
        {%- elsif resolved_option_selector_style == 'slider' -%}
          {%- liquid
            assign param_name = form_id | append: '-option' | append: option.position
            assign slider_default_downcase = slider_default_value | downcase | strip
            assign slider_message_lines = slider_messages | newline_to_br | split: '<br />'
            assign slider_digits = '0123456789'

            assign slider_amount_count = 0
            assign slider_treatment_count = 0
            assign slider_selected_index = nil
            assign slider_default_index = nil
            assign slider_first_amount = nil
            assign slider_last_amount = nil

            for option_value in option.values
              assign option_value_first_char = option_value.name | strip | slice: 0

              if slider_digits contains option_value_first_char
                if slider_first_amount == nil
                  assign slider_first_amount = option_value
                endif

                assign slider_last_amount = option_value

                if option_value.selected
                  assign slider_selected_index = slider_amount_count
                endif

                assign option_value_downcase = option_value.name | downcase | strip

                if slider_default_downcase != blank and option_value_downcase == slider_default_downcase
                  assign slider_default_index = slider_amount_count
                endif

                assign slider_amount_count = slider_amount_count | plus: 1
              else
                assign slider_treatment_count = slider_treatment_count | plus: 1
              endif
            endfor

            if slider_selected_index == nil
              assign slider_mode = 'treatment'
              assign slider_index = slider_default_index | default: 0
            else
              assign slider_mode = 'amount'
              assign slider_index = slider_selected_index
            endif

            assign slider_max = slider_amount_count | minus: 1

            if slider_max > 0
              assign slider_progress = slider_index | times: 100.0 | divided_by: slider_max
            else
              assign slider_progress = 100
            endif

            assign slider_current_id = nil
            assign slider_current_message = ''
            assign slider_amount_index = 0
          -%}

          <option-slider class="v-stack gap-4" {% if slider_default_index != nil %}default-index="{{ slider_default_index }}"{% endif %}>
            {%- if slider_treatment_count > 0 -%}
              <div class="h-stack gap-3 wrap">
                <button type="button" class="block-swatch {% if block_selector_style == 'fill' %}block-swatch--fill{% endif %} {% if slider_mode == 'amount' %}is-selected{% endif %}" data-mode-button="amount" aria-pressed="{% if slider_mode == 'amount' %}true{% else %}false{% endif %}">
                  {{- slider_amount_label | default: option.name | escape -}}
                </button>

                <button type="button" class="block-swatch {% if block_selector_style == 'fill' %}block-swatch--fill{% endif %} {% if slider_mode == 'treatment' %}is-selected{% endif %}" data-mode-button="treatment" aria-pressed="{% if slider_mode == 'treatment' %}true{% else %}false{% endif %}">
                  {{- slider_treatment_label | default: 'Behandling' | escape -}}
                </button>
              </div>
            {%- endif -%}

            <div data-mode-panel="amount" {% if slider_mode != 'amount' %}hidden{% endif %}>
              <div class="price-range">
                <script type="application/json">
                  [
                    {%- for option_value in option.values -%}
                      {%- liquid
                        assign option_value_first_char = option_value.name | strip | slice: 0

                        unless slider_digits contains option_value_first_char
                          continue
                        endunless

                        assign option_value_amount = option_value.name | remove: '.' | remove: ' ' | plus: 0
                        assign option_value_message = ''
                        assign option_value_message_amount = -1

                        for line in slider_message_lines
                          assign line_parts = line | split: ':'
                          assign line_amount = line_parts.first | strip | remove: '.' | plus: 0

                          if line_parts.size > 1 and line_amount <= option_value_amount and line_amount > option_value_message_amount
                            assign option_value_message_amount = line_amount
                            assign option_value_message = line | remove_first: line_parts.first | remove_first: ':' | strip
                          endif
                        endfor

                        if slider_amount_index == slider_index
                          assign slider_current_id = option_value.id
                          assign slider_current_message = option_value_message
                        endif
                      -%}

                      {% unless slider_amount_index == 0 %},{% endunless %}{ "id": {{ option_value.id | json }}, "name": {{ option_value.name | json }}, "message": {{ option_value_message | json }} }

                      {%- assign slider_amount_index = slider_amount_index | plus: 1 -%}
                    {%- endfor -%}
                  ]
                </script>

                <input class="sr-only" type="radio" tabindex="-1" aria-hidden="true" id="{{ param_name }}-value" form="{{ form_id }}" name="{{ param_name }}" data-option-position="{{ option.position }}" data-option-slider-value value="{{ slider_current_id }}" {% if slider_mode == 'amount' %}checked{% endif %}>

                <div class="range-group" style="--range-min: 0%; --range-max: {{ slider_progress }}%">
                  <input type="range" class="range" id="{{ param_name }}-slider" min="0" max="{{ slider_max }}" step="1" value="{{ slider_index }}" aria-label="{{ option.name | escape }}">
                </div>

                <div class="h-stack justify-between text-sm text-subdued">
                  <span>{{ slider_first_amount.name }}</span>
                  <span>{{ slider_last_amount.name }}</span>
                </div>

                <p class="text-sm" data-option-message {% if slider_current_message == blank %}hidden{% endif %}>{{ slider_current_message | escape }}</p>
              </div>
            </div>

            {%- if slider_treatment_count > 0 -%}
              {%- liquid
                assign slider_treatment_placeholder = slider_treatment_label | default: 'Behandling' | downcase | prepend: 'Vælg '
                assign slider_selected_treatment_label = nil
              -%}

              {%- capture slider_treatment_options -%}
                {%- for option_value in option.values -%}
                  {%- liquid
                    assign option_value_first_char = option_value.name | strip | slice: 0

                    if slider_digits contains option_value_first_char
                      continue
                    endif

                    assign treatment_label = option_value.name

                    if option_value.variant
                      assign treatment_price = option_value.variant.price | money_without_trailing_zeros
                      assign treatment_label = option_value.name | append: ' · ' | append: treatment_price
                    endif

                    if option_value.selected
                      assign slider_selected_treatment_label = treatment_label
                    endif
                  -%}

                  {%- if hide_sold_out_variants == false or option_value.available or option_value.selected -%}
                    <label class="popover__value-option" for="{{ param_name }}-{{ option_value.id }}">
                      <input class="sr-only" type="radio" id="{{ param_name }}-{{ option_value.id }}" form="{{ form_id }}" name="{{ param_name }}" data-option-position="{{ option.position }}" value="{{ option_value.id }}" {% if option_value.selected %}checked{% endif %}>
                      <span {% if option_value.available == false %}class="line-through"{% endif %}>{{- treatment_label -}}</span>
                    </label>
                  {%- endif -%}
                {%- endfor -%}
              {%- endcapture -%}

              <div data-mode-panel="treatment" {% if slider_mode != 'treatment' %}hidden{% endif %}>
                <div class="relative">
                  {%- capture popover_id -%}popover-variant-treatment-{{ section.id }}-{{ product.id }}-{{ option.position }}{%- endcapture -%}

                  <button type="button" class="select {% if settings.input_uppercase %}subheading{% endif %}" aria-controls="{{ popover_id }}" aria-expanded="false">
                    <span id="{{ popover_id }}-selected-value" data-treatment-selected-value>{{- slider_selected_treatment_label | default: slider_treatment_placeholder -}}</span>
                    {%- render 'icon' with 'chevron-down' -%}
                  </button>

                  <x-popover id="{{ popover_id }}" class="popover popover--w-full color-scheme color-scheme--{{ settings.default_color_scheme.id }}" close-on-listbox-change>
                    <p class="h6" slot="header">{{ slider_treatment_label | default: 'Behandling' | escape }}</p>

                    <div class="popover__value-list">
                      {{- slider_treatment_options -}}
                    </div>
                  </x-popover>
                </div>
              </div>
            {%- endif -%}
          </option-slider>

          <script src="{{ 'option-slider.js' | asset_url }}" type="module"></script>
        {%- elsif resolved_option_selector_style == 'dropdown' -%}
          <div class="relative">
            {%- capture popover_id -%}popover-variant-dropdown-{{ section.id }}-{{ product.id }}-{{ option.position }}{%- endcapture -%}

            <button type="button" class="select {% if settings.input_uppercase %}subheading{% endif %}" aria-controls="{{ popover_id }}" aria-expanded="false">
              <span id="{{ popover_id }}-selected-value">{{- option.selected_value -}}</span>
              {%- render 'icon' with 'chevron-down' -%}
            </button>

            <x-popover id="{{ popover_id }}" class="popover popover--w-full color-scheme color-scheme--{{ settings.default_color_scheme.id }}" close-on-listbox-change>
              <p class="h6" slot="header">{{ option.name }}</p>

              <div class="popover__value-list">
                {%- assign param_name = form_id | append: '-option' | append: option.position -%}
                
                {%- for option_value in option.values -%}
                  {%- capture option_markup -%}
                    <span {% if option_value.available == false %}class="line-through"{% endif %}>{{- option_value -}}</span>
                  {%- endcapture -%}

                  {%- if hide_sold_out_variants == false or option_value.available or option_value.selected -%}
                    {%- if is_main_product and option_value.product_url != blank -%}
                      <div class="popover__value-option">
                        {%- if option_value.selected -%}
                          <input class="sr-only" type="radio" id="{{ param_name }}-{{ option_value.id }}" form="{{ form_id }}" name="{{ param_name }}" data-option-position="{{ option.position }}" value="{{ option_value.id }}" checked>
                        {%- endif -%}

                        <a href="{{ option_value.variant.url | default: option_value.product_url }}" class="h-stack justify-between gap-2 link-faded-reverse">
                          {{- option_markup -}}
                        </a>
                      </div>
                    {%- else -%}
                      <label class="popover__value-option" for="{{ param_name }}-{{ option_value.id }}">
                        <input class="sr-only" type="radio" id="{{ param_name }}-{{ option_value.id }}" form="{{ form_id }}" name="{{ param_name }}" {% if option_value.product_url != blank %}data-product-url="{{ option_value.product_url | escape }}"{% endif %} data-option-position="{{ option.position }}" value="{{ option_value.id }}" {% if option_value.selected %}checked{% endif %}>
                        {{- option_markup -}}
                      </label>
                    {%- endif -%}
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </x-popover>
          </div>
        {%- else -%}
          {%- liquid
            case resolved_option_selector_style
              when 'swatch'
                case settings.color_swatch_shape
                  when 'circle'
                    if swatch_selector_size == 'sm'
                      assign list_classes = 'h-stack gap-3 wrap'
                    else
                      assign list_classes = 'h-stack gap-4 wrap'
                    endif

                  else
                    if swatch_selector_size == 'sm'
                      assign list_classes = 'h-stack gap-3 wrap'
                    else
                      assign list_classes = 'h-stack gap-4 wrap'
                    endif
                endcase
              when 'variant_image'
                assign list_classes = 'h-stack gap-1 wrap'
              else
                assign list_classes = 'h-stack gap-3 wrap'
            endcase
          -%}

          <div class="variant-picker__option-values {{ list_classes }}">
            {% liquid
              assign name = form_id | append: '-option' | append: option.position

              for option_value in option.values
                case resolved_option_selector_style
                  when 'variant_image'
                    render 'option-value', type: 'thumbnail', form: form_id, option_value: option_value, param_name: name, option_position: option.position, size: swatch_selector_size, hide_if_disabled: hide_sold_out_variants, reload_page_for_combined_products: is_main_product, id_prefix: forloop.index
                  when 'swatch'
                    render 'option-value', type: 'swatch', form: form_id, option_value: option_value, param_name: name, option_position: option.position, size: swatch_selector_size, hide_if_disabled: hide_sold_out_variants, reload_page_for_combined_products: is_main_product, id_prefix: forloop.index
                  when 'block'
                    render 'option-value', type: 'block', form: form_id, option_value: option_value, param_name: name, option_position: option.position, style: block_selector_style, hide_if_disabled: hide_sold_out_variants, reload_page_for_combined_products: is_main_product, id_prefix: forloop.index
                  when 'block_swatch'
                    render 'option-value', type: 'block', form: form_id, option_value: option_value, param_name: name, option_position: option.position, style: block_selector_style, show_swatch: true, hide_if_disabled: hide_sold_out_variants, reload_page_for_combined_products: is_main_product, id_prefix: forloop.index
                endcase
              endfor
            %}
          </div>
        {%- endif -%}
      </fieldset>

      {%- if separate_options and forloop.last == false -%}
        <hr>
      {%- endif -%}
    {%- endfor -%}
  </variant-picker>
{%- endunless -%}
