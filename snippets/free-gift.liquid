{%- comment -%}
----------------------------------------------------------------------------------------------------------------------
FREE GIFT (BEHAVIOUR)
----------------------------------------------------------------------------------------------------------------------

Defines the <free-gift> custom element, which keeps the cart in sync with the state rendered by sections/free-gift.liquid.

Concurrency:
  * a mutex (#isSyncing) guarantees that only one reconciliation runs at a time; changes arriving during a sync set a
    dirty flag which triggers exactly one extra pass
  * every pass recomputes from server-rendered state, never from local assumptions
  * MAX_SYNC_PASSES caps the reconciliation loop
  * the element dispatches "cart:change" with baseEvent "free-gift:change" and ignores that base event, so it can never
    react to its own mutations
{%- endcomment -%}

{%- if settings.gift_enabled or settings.gift_threshold_enabled or settings.gift_choice_enabled -%}
  <script type="module">
    import { extractSectionId } from 'theme';

    const MAX_SYNC_PASSES = 3;
    const RELOAD_GUARD_KEY = 'free-gift:reload-count';
    const CELEBRATION_ENABLED = {{ settings.gift_celebration_enabled | json }};
    const CELEBRATION_TEXT = {{ settings.gift_celebration_text | json }};
    const CELEBRATION_COLORS = ['#f6a429', '#3a2d28', '#a38274', '#f9efe6', '#ffffff'];

    export class FreeGift extends HTMLElement {
      #sectionId;
      #abortController;
      #isSyncing = false;
      #isDirty = false;

      connectedCallback() {
        this.#sectionId ??= extractSectionId(this);
        this.#abortController = new AbortController();

        document.addEventListener('cart:prepare-bundled-sections', this.#onBundleSection.bind(this), {signal: this.#abortController.signal});
        document.addEventListener('cart:change', this.#onCartChange.bind(this), {signal: this.#abortController.signal});
        document.addEventListener('cart:refresh', this.#onCartRefresh.bind(this), {signal: this.#abortController.signal});
        document.addEventListener('click', this.#onSwapClick.bind(this), {signal: this.#abortController.signal});

        // Reconcile on load, based on the server-rendered state. This also covers the cart page, where the theme
        // reloads the page instead of dispatching "cart:change".
        this.#sync(this.#readState(this));
      }

      disconnectedCallback() {
        this.#abortController?.abort();
      }

      /**
       * Makes sure our own section is re-rendered by any cart mutation performed by the theme
       */
      #onBundleSection(event) {
        event.detail.sections.add(this.#sectionId);
      }

      #onCartChange(event) {
        if (event.detail?.baseEvent === 'free-gift:change') {
          return; // Never react to our own mutation
        }

        this.#sync(this.#parseState(event.detail?.cart?.['sections']?.[this.#sectionId]));
      }

      #onCartRefresh() {
        this.#sync(null);
      }

      /**
       * ---------------------------------------------------------------------------------------------------------------
       * STATE
       * ---------------------------------------------------------------------------------------------------------------
       */

      #readState(root) {
        try {
          return JSON.parse(root?.querySelector('[data-free-gift-state]')?.textContent);
        } catch (error) {
          return null;
        }
      }

      #parseState(markup) {
        if (!markup) {
          return null;
        }

        const document_ = (new DOMParser()).parseFromString(markup, 'text/html');
        return this.#readState(document_.querySelector('free-gift'));
      }

      async #fetchState() {
        try {
          const response = await fetch(`${Shopify.routes.root}?section_id=${this.#sectionId}`);
          return response.ok ? this.#parseState(await response.text()) : null;
        } catch (error) {
          return null;
        }
      }

      #persistState(state) {
        const stateElement = this.querySelector('[data-free-gift-state]');

        if (stateElement) {
          stateElement.textContent = JSON.stringify(state);
        }
      }

      /**
       * ---------------------------------------------------------------------------------------------------------------
       * RECONCILIATION
       * ---------------------------------------------------------------------------------------------------------------
       */

      async #sync(initialState = null) {
        if (this.#isSyncing) {
          this.#isDirty = true; // A change arrived mid-flight, we will do one more pass
          return;
        }

        this.#isSyncing = true;
        let state = initialState;

        try {
          for (let pass = 0; pass < MAX_SYNC_PASSES; pass++) {
            this.#isDirty = false;
            state ??= await this.#fetchState();

            if (!state) {
              break;
            }

            this.#persistState(state);
            const operation = this.#resolveOperation(state);

            if (!operation) {
              this.#clearReloadGuard();

              if (!this.#isDirty) {
                break;
              }

              state = null;
              continue;
            }

            const cart = await this.#applyOperation(operation);

            if (!cart) {
              break; // The request failed, we stop rather than retrying in a loop
            }

            this.#notify(cart);

            if (this.#reloadCartPage()) {
              return;
            }

            const previousGiftQuantity = this.#countGifts(state);
            state = this.#parseState(cart['sections']?.[this.#sectionId]);

            if (this.#countGifts(state) > previousGiftQuantity) {
              this.#celebrate();
            }
          }
        } finally {
          this.#isSyncing = false;
        }
      }

      /**
       * Returns the single operation needed to bring the cart in line with the state, or null when nothing to do.
       * Each pool owns the gift lines matching its variants, and the sum of those lines must match the pool target
       * computed in Liquid. Gift lines that do not belong to any pool are removed.
       */
      #resolveOperation(state) {
        const giftLines = state.gift_lines || [],
              claimedKeys = new Set(),
              updates = {};

        (state.pools || []).forEach((pool) => {
          const variantIds = pool.variants.map((variant) => variant.id),
                poolLines = giftLines.filter((line) => variantIds.includes(line.variant_id)),
                currentQuantity = poolLines.reduce((total, line) => total + line.quantity, 0),
                targetQuantity = Math.max(pool.target_quantity || 0, 0);

          poolLines.forEach((line) => claimedKeys.add(line.key));

          if (currentQuantity > targetQuantity) {
            // We remove the excess starting from the last line, so the gift picked first by the customer is kept
            let excess = currentQuantity - targetQuantity;

            [...poolLines].reverse().forEach((line) => {
              const removed = Math.min(line.quantity, excess);

              if (removed > 0) {
                updates[line.key] = line.quantity - removed;
                excess -= removed;
              }
            });
          } else if (currentQuantity < targetQuantity) {
            // We add the missing units to the first variant that still has room (the first variant is the default gift)
            let missing = targetQuantity - currentQuantity;

            pool.variants.forEach((variant) => {
              const variantLines = poolLines.filter((line) => line.variant_id === variant.id),
                    variantQuantity = variantLines.reduce((total, line) => total + line.quantity, 0),
                    room = variant.max < 0 ? missing : Math.max(variant.max - variantQuantity, 0),
                    added = Math.min(missing, room);

              if (added > 0) {
                if (variantLines.length > 0) {
                  updates[variantLines[0].key] = variantLines[0].quantity + added;
                } else {
                  updates[variant.id] = added; // cart/update.js adds the variant when it is not in the cart yet
                }

                missing -= added;
              }
            });
          }
        });

        giftLines.filter((line) => !claimedKeys.has(line.key)).forEach((line) => updates[line.key] = 0);

        return Object.keys(updates).length > 0 ? {updates} : null;
      }

      async #applyOperation(operation) {
        // Allow every cart-aware component to be re-rendered in the same round trip
        let sectionsToBundle = new Set();
        sectionsToBundle.add(this.#sectionId);
        document.documentElement.dispatchEvent(new CustomEvent('cart:prepare-bundled-sections', {bubbles: true, detail: {sections: sectionsToBundle}}));

        try {
          const response = await fetch(`${Shopify.routes.root}cart/update.js`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'X-Requested-With': 'XMLHttpRequest' // Needed for Shopify to check inventory
            },
            body: JSON.stringify({updates: operation.updates, sections: [...sectionsToBundle].join(',')})
          });

          return response.ok ? await response.json() : null; // cart/update.js returns the whole cart
        } catch (error) {
          return null;
        }
      }

      /**
       * ---------------------------------------------------------------------------------------------------------------
       * GIFT CHOICE
       * ---------------------------------------------------------------------------------------------------------------
       */

      async #onSwapClick(event) {
        const button = event.target.closest?.('[data-free-gift-swap]');

        if (!button) {
          return;
        }

        event.preventDefault();

        if (this.#isSyncing) {
          return;
        }

        const state = this.#readState(this),
              line = (state?.gift_lines || []).find((giftLine) => giftLine.key === button.getAttribute('data-line-key')),
              targetVariantId = parseInt(button.getAttribute('data-variant-id'), 10),
              pool = (state?.pools || []).find((pool) => pool.variants.some((variant) => variant.id === targetVariantId));

        // The swap is only allowed between two gifts of the same pool
        if (!line || !pool || line.variant_id === targetVariantId || !pool.variants.some((variant) => variant.id === line.variant_id)) {
          return;
        }

        const targetLine = state.gift_lines.find((giftLine) => giftLine.variant_id === targetVariantId),
              updates = {[line.key]: line.quantity - 1};

        if (targetLine) {
          updates[targetLine.key] = targetLine.quantity + 1;
        } else {
          updates[targetVariantId] = 1;
        }

        this.#isSyncing = true;
        button.setAttribute('aria-busy', 'true');
        button.disabled = true;

        let cart = null;

        try {
          cart = await this.#applyOperation({updates});
        } finally {
          this.#isSyncing = false;
        }

        if (!cart) {
          button.removeAttribute('aria-busy');
          button.disabled = false;
          return;
        }

        this.#notify(cart);

        if (this.#reloadCartPage()) {
          return;
        }

        // The pool total is unchanged, but we still run a pass so that any change that arrived meanwhile is handled
        this.#sync(this.#parseState(cart['sections']?.[this.#sectionId]));
      }

      /**
       * We use a dedicated base event so the cart drawer refreshes without opening itself, and so that this component
       * ignores the change it caused
       */
      #notify(cart) {
        document.documentElement.dispatchEvent(new CustomEvent('cart:change', {
          bubbles: true,
          detail: {
            baseEvent: 'free-gift:change',
            cart: cart
          }
        }));
      }

      /**
       * ---------------------------------------------------------------------------------------------------------------
       * CART PAGE
       * ---------------------------------------------------------------------------------------------------------------
       *
       * On the cart page the theme reloads instead of re-rendering, so we do the same. The counter guarantees that a
       * mutation which can never settle cannot cause a reload loop.
       */

      #reloadCartPage() {
        if (window.themeVariables.settings.pageType !== 'cart') {
          return false;
        }

        let reloadCount = 0;

        try {
          reloadCount = parseInt(sessionStorage.getItem(RELOAD_GUARD_KEY) || '0', 10);
        } catch (error) {
          // Safari in private mode does not allow access, we silently fail
        }

        if (reloadCount >= 2) {
          return false;
        }

        try {
          sessionStorage.setItem(RELOAD_GUARD_KEY, String(reloadCount + 1));
        } catch (error) {
          // Safari in private mode does not allow setting item, we silently fail
        }

        window.location.reload();
        return true;
      }

      #clearReloadGuard() {
        try {
          sessionStorage.removeItem(RELOAD_GUARD_KEY);
        } catch (error) {
          // Safari in private mode does not allow access, we silently fail
        }
      }

      /**
       * ---------------------------------------------------------------------------------------------------------------
       * CELEBRATION
       * ---------------------------------------------------------------------------------------------------------------
       *
       * Shown when the reconciliation has added a gift. Everything is created on demand and removed afterwards, so
       * nothing is loaded or rendered until a gift is actually added.
       */

      #countGifts(state) {
        return (state?.gift_lines || []).reduce((total, line) => total + line.quantity, 0);
      }

      #celebrate() {
        if (!CELEBRATION_ENABLED || document.querySelector('[data-free-gift-celebration]')) {
          return;
        }

        const duration = 3000,
              overlay = document.createElement('div'),
              message = document.createElement('p');

        overlay.setAttribute('data-free-gift-celebration', '');
        overlay.setAttribute('role', 'status');
        overlay.style.cssText = 'position: fixed; inset: 0; z-index: 99999999; display: grid; place-items: center; padding: 1.5rem; pointer-events: none;';

        message.className = 'h1 text-center color-scheme color-scheme--{{ settings.default_color_scheme.id }}';
        message.style.cssText = 'position: relative; max-width: 40rem; padding: 1.5rem 2rem; border-radius: 1.5rem; box-shadow: 0 1rem 3rem rgb(0 0 0 / 0.2);';
        message.textContent = CELEBRATION_TEXT;

        overlay.append(message);
        document.body.append(overlay);

        message.animate([
          {opacity: 0, transform: 'scale(0.8)'},
          {opacity: 1, transform: 'scale(1)', offset: 0.1},
          {opacity: 1, transform: 'scale(1)', offset: 0.85},
          {opacity: 0, transform: 'scale(1)'}
        ], {duration, easing: 'ease-out', fill: 'forwards'});

        setTimeout(() => overlay.remove(), duration);

        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          return; // The message is enough, we do not animate confetti
        }

        const canvas = document.createElement('canvas'),
              context = canvas.getContext('2d'),
              ratio = Math.min(window.devicePixelRatio || 1, 2),
              width = window.innerWidth,
              height = window.innerHeight;

        canvas.width = width * ratio;
        canvas.height = height * ratio;
        canvas.style.cssText = 'position: absolute; inset: 0; width: 100%; height: 100%;';
        context.scale(ratio, ratio);
        overlay.prepend(canvas);

        const particles = Array.from({length: 120}, () => {
          const angle = Math.random() * Math.PI * 2,
                speed = 6 + Math.random() * 10;

          return {
            x: width / 2,
            y: height / 2,
            velocityX: Math.cos(angle) * speed,
            velocityY: Math.sin(angle) * speed - 6,
            size: 6 + Math.random() * 6,
            rotation: Math.random() * Math.PI,
            spin: (Math.random() - 0.5) * 0.4,
            color: CELEBRATION_COLORS[Math.floor(Math.random() * CELEBRATION_COLORS.length)]
          };
        });

        const startTime = performance.now();

        const draw = (now) => {
          const progress = (now - startTime) / duration;

          if (progress >= 1 || !overlay.isConnected) {
            return;
          }

          context.clearRect(0, 0, width, height);
          context.globalAlpha = Math.min(1, (1 - progress) * 2);

          particles.forEach((particle) => {
            particle.velocityY += 0.35; // Gravity
            particle.velocityX *= 0.99;
            particle.x += particle.velocityX;
            particle.y += particle.velocityY;
            particle.rotation += particle.spin;

            context.save();
            context.translate(particle.x, particle.y);
            context.rotate(particle.rotation);
            context.fillStyle = particle.color;
            context.fillRect(-particle.size / 2, -particle.size / 4, particle.size, particle.size / 2);
            context.restore();
          });

          requestAnimationFrame(draw);
        };

        requestAnimationFrame(draw);
      }
    }

    if (!window.customElements.get('free-gift')) {
      window.customElements.define('free-gift', FreeGift);
    }
  </script>
{%- endif -%}