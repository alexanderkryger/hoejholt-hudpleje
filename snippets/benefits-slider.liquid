{%- comment -%}
----------------------------------------------------------------------------------------------------------------------
BENEFITS SLIDER
----------------------------------------------------------------------------------------------------------------------

Renders a horizontal card slider for product benefits/USPs on the product page.
Integrates as a block within main-product via product-info.

********************************************
Supported variables
********************************************

* block: the current block object (passed automatically from product-info)
* alignment: text alignment context from product-info (start, center, end)
{%- endcomment -%}

{%- liquid
  assign slider_id = 'benefits-slider-' | append: block.id
  assign has_items = false

  for i in (1..3)
    assign image_key = 'slide_image_' | append: i
    assign text_key = 'slide_text_' | append: i
    if block.settings[image_key] != blank or block.settings[text_key] != blank
      assign has_items = true
      break
    endif
  endfor
-%}

{%- if has_items -%}
  <div class="benefits-slider" id="{{ slider_id }}" {{ block.shopify_attributes }}>
    {%- if block.settings.heading != blank -%}
      <div class="benefits-slider__header">
        <p class="benefits-slider__title">{{ block.settings.heading | escape }}</p>

        <div class="benefits-slider__nav">
          <button
            type="button"
            class="benefits-slider__arrow benefits-slider__arrow--prev"
            aria-label="{{ 'general.accessibility.previous' | t }}"
            aria-controls="{{ slider_id }}-track"
            disabled
          >
            {%- render 'icon' with 'big-arrow-left', width: 9, direction_aware: true -%}
          </button>

          <button
            type="button"
            class="benefits-slider__arrow benefits-slider__arrow--next"
            aria-label="{{ 'general.accessibility.next' | t }}"
            aria-controls="{{ slider_id }}-track"
          >
            {%- render 'icon' with 'big-arrow-right', width: 9, direction_aware: true -%}
          </button>
        </div>
      </div>
    {%- endif -%}

    <div class="benefits-slider__track" id="{{ slider_id }}-track" role="list">
      {%- for i in (1..4) -%}
        {%- liquid
          assign image_key = 'slide_image_' | append: i
          assign text_key = 'slide_text_' | append: i
          assign slide_image = block.settings[image_key]
          assign slide_text = block.settings[text_key]
        -%}

        {%- if slide_image != blank or slide_text != blank -%}
          <div class="benefits-slider__card" role="listitem">
            {%- if slide_image != blank -%}
              <div class="benefits-slider__card-image">
                {{- slide_image | image_url: width: 600 | image_tag:
                  loading: 'lazy',
                  sizes: '(max-width: 599px) 60vw, (max-width: 999px) 40vw, 260px',
                  widths: '200,300,400,500,600',
                  class: 'benefits-slider__img'
                -}}
              </div>
            {%- else -%}
              <div class="benefits-slider__card-image benefits-slider__card-placeholder">
                {{ 'lifestyle-1' | placeholder_svg_tag: 'benefits-slider__placeholder-svg' }}
              </div>
            {%- endif -%}

            {%- if slide_text != blank -%}
              <div class="benefits-slider__card-content">
                <p class="benefits-slider__card-text">{{ slide_text | escape }}</p>
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  <style>
    .benefits-slider {
      --bs-card-radius: 16px;
      --bs-card-aspect: 4 / 5;
      --bs-gap: 12px;
      --bs-card-min-width: 180px;
      --bs-overlay-gradient: linear-gradient(
        to bottom,
        rgba(0, 0, 0, 0.02) 0%,
        rgba(0, 0, 0, 0.30) 100%
      );

      width: 100%;
      overflow: hidden;
    }

    /* ---- Header row ---- */
    .benefits-slider__header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-block-end: 16px;
    }

    .benefits-slider__title {
      font-weight: 600;
      font-size: 1rem;
      line-height: 1.3;
      margin: 0;
    }

    .benefits-slider__nav {
      display: flex;
      gap: 6px;
      align-items: center;
    }

    .benefits-slider__arrow {
      appearance: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 32px;
      height: 32px;
      padding: 0;
      border: 1px solid rgba(0, 0, 0, 0.15);
      border-radius: 50%;
      background: transparent;
      cursor: pointer;
      transition: opacity 0.2s ease, border-color 0.2s ease;
      color: currentColor;
    }

    .benefits-slider__arrow:disabled {
      opacity: 0.3;
      cursor: default;
      pointer-events: none;
    }

    .benefits-slider__arrow:not(:disabled):hover {
      border-color: rgba(0, 0, 0, 0.4);
    }

    .benefits-slider__arrow svg {
      width: 10px;
      height: 10px;
    }

    /* ---- Track (scrollable) ---- */
    .benefits-slider__track {
      display: flex;
      gap: var(--bs-gap);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-behavior: smooth;
      scrollbar-width: none;          /* Firefox */
      -ms-overflow-style: none;       /* IE / old Edge */
      -webkit-overflow-scrolling: touch;
      padding-block: 2px;             /* prevents clipping of shadows */
    }

    .benefits-slider__track::-webkit-scrollbar {
      display: none;                  /* Chrome / Safari */
    }

    /* ---- Cards ---- */
    .benefits-slider__card {
      position: relative;
      flex: 0 0 auto;
      width: calc((100% - var(--bs-gap)) / 2.15);  /* show ~2 + peek */
      min-width: var(--bs-card-min-width);
      aspect-ratio: var(--bs-card-aspect);
      border-radius: var(--bs-card-radius);
      overflow: hidden;
      scroll-snap-align: start;
      background: #d4a88c;           /* warm fallback while image loads */
    }

    @media screen and (min-width: 700px) {
      .benefits-slider__card {
        width: calc((100% - var(--bs-gap) * 2) / 2.35);
      }
    }

    /* Image layer */
    .benefits-slider__card-image {
      position: absolute;
      inset: 0;
    }

    .benefits-slider__img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .benefits-slider__card-placeholder {
      background: #c09070;
    }

    .benefits-slider__placeholder-svg {
      width: 100%;
      height: 100%;
      object-fit: cover;
      opacity: 0.3;
    }

    /* Text overlay */
    .benefits-slider__card-content {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: top;
      justify-content: center;
      padding: 20px 16px;
      text-align: center;
    }

    .benefits-slider__card-text {
      color: #ffffff;
      font-size: clamp(1.1rem, 3.5vw, 1.4rem);
      line-height: 1.25;
      margin: 0;
      text-shadow: 0 1px 6px rgba(0, 0, 0, 0.25);
      word-break: break-word;
      /* Limit to 3 lines with ellipsis */
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    /* ---- Responsive tweaks ---- */
    @media screen and (max-width: 449px) {
      .benefits-slider__card {
        width: calc((100% - var(--bs-gap)) / 1.8);
        min-width: 150px;
      }
    }

    @media screen and (min-width: 1000px) {
      .benefits-slider__card {
        width: calc((100% - var(--bs-gap) * 2) / 2.5);
      }

      .benefits-slider__card-text {
        font-size: 1.35rem;
      }
    }
  </style>

  <script>
    /* Benefits Slider – lightweight scroll-based slider */
    (function () {
      var root = document.getElementById('{{ slider_id }}');
      if (!root) return;

      var track = root.querySelector('.benefits-slider__track');
      var prevBtn = root.querySelector('.benefits-slider__arrow--prev');
      var nextBtn = root.querySelector('.benefits-slider__arrow--next');

      if (!track) return;

      function getScrollStep() {
        var firstCard = track.querySelector('.benefits-slider__card');
        if (!firstCard) return track.offsetWidth;
        return firstCard.offsetWidth + parseInt(getComputedStyle(track).gap || 12, 10);
      }

      function updateButtons() {
        if (!prevBtn || !nextBtn) return;
        var scrollLeft = Math.round(track.scrollLeft);
        var maxScroll = track.scrollWidth - track.offsetWidth;

        prevBtn.disabled = scrollLeft <= 2;
        nextBtn.disabled = scrollLeft >= maxScroll - 2;
      }

      if (prevBtn) {
        prevBtn.addEventListener('click', function () {
          track.scrollBy({ left: -getScrollStep(), behavior: 'smooth' });
        });
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', function () {
          track.scrollBy({ left: getScrollStep(), behavior: 'smooth' });
        });
      }

      track.addEventListener('scroll', updateButtons, { passive: true });
      updateButtons();

      /* Re-evaluate on resize */
      if (typeof ResizeObserver !== 'undefined') {
        new ResizeObserver(updateButtons).observe(track);
      }
    })();
  </script>
{%- endif -%}
