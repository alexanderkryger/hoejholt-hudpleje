speed":6,"background":"#000000"}},"text_with_media_d8aMik":{"type":"text-with-media","blocks":{"subheading_KyyrAY":{"type":"subheading","settings":{"text":"Vores filosofi","position":"top_left"}},"heading_TpgMMw":{"type":"heading","settings":{"text":"Hver hud fortjener enestående pleje","heading_tag":"h2","position":"middle_left","highlight_effect":"tilted_marker","highlight_accent_color":"#f6a429","highlight_text_color":""}},"richtext_GgQPE3":{"type":"richtext","settings":{"text":"<p>Hos Højholt Hudpleje arbejder vi målrettet for at skabe synlige, varige resultater. Vi tror ikke på hurtige løsninger, men på faglighed, grundighed og personlig vejledning. Vores mission er at hjælpe dig med at opnå en sund, stærk og balanceret hud – uanset hvor du starter.<\/p>","position":"bottom_left"}}},"block_order":["subheading_KyyrAY","heading_TpgMMw","richtext_GgQPE3"],"name":"t:sections.text_with_media.name","settings":{"color_scheme":"scheme-1","content_position":"end","content_percentage_width":50,"overlay_color":"#000000","overlay_opacity":20,"add_media_spacing":false,"autoplay_video":true,"primary_image":"shopify:\/\/shop_images\/about-split-media-01.jpg","secondary_video":"shopify:\/\/files\/videos\/video_hojholt_forside_mobil.mp4","secondary_media_width":60,"secondary_media_mobile_width":60,"show_secondary_media_on_mobile":true,"secondary_media_alignment":"place-self-center","secondary_media_shape":"none"}},"text_with_fixed_background_WKKGBX":{"type":"text-with-fixed-background","blocks":{"title_N6mAhp":{"type":"title","settings":{"content_position":"md:place-self-start","subheading":"vores produktvalg","title":"Alle vores produkter er omhyggeligt udvalgt","heading_tag":"h2","highlight_effect":"default","highlight_accent_color":"","highlight_text_color":""}},"content_e4nqzY":{"type":"content","settings":{"color_scheme":"","content_position":"md:place-self-end","title":"Vores produktudvalg","content":"<p>Hos Højholt Hudpleje går vi ikke på kompromis med det, vi bruger og anbefaler.  Vi arbejder udelukkende med brands, vi stoler på – og som vi ved skaber resultater.<\/p><p><strong>Vi forhandler bl.a.:<\/strong><br\/><br\/>pHformula · IS Clinical · Heliocare · Jane Iredale · Sanzi · Team Dr. Joseph · Lycon · Marc Inbane · Organic Konjac · Original Dermaroller<\/p>","indent_heading":false}}},"block_order":["title_N6mAhp","content_e4nqzY"],"name":"t:sections.text_with_fixed_background.name","settings":{"color_scheme":"","image":"shopify:\/\/shop_images\/tdj_coverbillede.jpg","overlay_color":"#321e1e","overlay_opacity":30}},"text_with_media_LpXxmF":{"type":"text-with-media","blocks":{"subheading_qFDhHP":{"type":"subheading","settings":{"text":"Grundlagt af Simone","position":"top_left"}},"heading_NgQXzH":{"type":"heading","settings":{"text":"Højholt Hudpleje er grundlagt af Simone Højholt i 2016 med en vision om at gøre en reel <em>forskel <\/em>for mennesker og deres hud.","heading_tag":"h3","position":"top_left","highlight_effect":"tilted_marker","highlight_accent_color":"#fbf0e8","highlight_text_color":"#a58475"}},"richtext_hAJiF8":{"type":"richtext","settings":{"text":"<p>Min passion for hudpleje begyndte tidligt, og det har altid været vigtigt for mig at arbejde fagligt og målrettet med huden – men altid med respekt for den enkelte. For mig handler det ikke om hurtige løsninger, men om at forstå huden i dybden og skabe resultater, der holder.<\/p><p>Tak fordi du har lyst til at lære os bedre at kende – jeg glæder mig til at byde dig velkommen i klinikken.<br\/><\/p>","position":"bottom_left"}}},"block_order":["subheading_qFDhHP","heading_NgQXzH","richtext_hAJiF8"],"name":"t:sections.text_with_media.name","settings":{"color_scheme":"scheme-5","content_position":"start","content_percentage_width":50,"overlay_color":"#000000","overlay_opacity":20,"add_media_spacing":false,"autoplay_video":true,"primary_image":"shopify:\/\/shop_images\/hoejholt-hudpleje_personale.jpg","secondary_media_width":60,"secondary_media_mobile_width":60,"show_se