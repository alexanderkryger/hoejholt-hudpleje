<\/strong><\/a> sendes direkte til modtagerens indbakke og kan bruges både online og i klinikken.<br\/><br\/>Ønsker du at give en oplevelse, kan du vælge et <a href=\"https:\/\/www.hoejholthudpleje.dk\/products\/gavekort-ansigtsbehandlinger\"><strong>e-mail gavekort til ansigtsbehandling<\/strong><\/a> – en smuk gave, der giver ro, resultater og personlig pleje.<\/p><p>Uanset hvilken type du vælger, er et gavekort fra Højholt Hudpleje en gave med omtanke, faglighed og velvære i fokus.<\/p>","content_width":"sm"},"blocks":{}}},"block_order":["heading_8xzhnz","rich_text_F9KmJe"]},"section-header":{"type":"_section-header","static":true,"settings":{"subheading":"","title":"","content":"","button_text":"","button_link":"","button_style":"outline","text_alignment":"left","heading_size":"h3","title_icon":"none","show_scrolling_title":false},"blocks":{}}},"block_order":["multi_column_column_jHyVML","multi_column_column_xpniYH","multi_column_column_p4HmLM"],"name":"t:sections.multi_column.name","settings":{"color_scheme":"","show_internal_borders":false,"add_horizontal_spacing":true,"add_top_spacing":true,"add_bottom_spacing":true,"items_per_row":2,"stack_on_mobile":false,"stack_on_desktop":true,"column_spacing":"md","row_spacing":"md"}}},"order":["banner","main","multi_column_3RxTRk"]}