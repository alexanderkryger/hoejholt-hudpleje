p_2.png","badge":"Trustpilot","title":"Over 100 anmeldelser med 5 stjerner&nbsp;","url":"","text_color":"#ffffff"}},"usp_3gFxJk":{"type":"usp","settings":{"image":"shopify:\/\/shop_images\/hojholt_hudpleje_usp_3.png","badge":"Vi hjælper dig","title":"&nbsp;Personlig rådgivning om din hudpleje","url":"","text_color":"#ffffff"}}},"block_order":["usp_Bheeym","usp_mCeqhi","usp_wHhnja","usp_jRByVE","usp_3gFxJk"],"name":"t:sections.usp_slider.name","settings":{"color_scheme":"scheme-8d0856b4-0efb-4f59-b45e-7e70b861b6d0","panel_color_scheme":"scheme-7","panel_border_radius":24,"bleed_end":true,"subheading":"Bedre service","title":"HVORFOR OS","heading_tag":"h3","vertical_heading":true,"vertical_heading_alignment":"end","items_per_row":3,"card_aspect_ratio":"portrait","card_border_radius":16,"card_heading_style":"h5","text_position":"place-self-center-start","overlay_color":"#000000","overlay_opacity":20,"show_arrows":true}},"multi_column_3RxTRk":{"type":"multi-column","blocks":{"multi_column_column_jHyVML":{"type":"_multi-column-column","settings":{"color_scheme":"scheme-8d0856b4-0efb-4f59-b45e-7e70b861b6d0","text_alignment":"left"},"blocks":{"heading_WtdUzz":{"type":"heading","settings":{"text":"Black Week hos Højholt Hudpleje: eksklusive tilbud på professionel hudpleje&nbsp;","heading_size":"h4","html_tag":"h2","indent":"none","highlight_effect":"default","highlight_accent_color":"","highlight_text_color":""},"blocks":{}},"rich_text_MaEM37":{"type":"rich-text","settings":{"text":"<p>Black Week er den ene uge om året, hvor vi giver vores bedste priser på de produkter, vi selv står inde for. I 10 år har vi haft fokus på resultatorienteret hudpleje, personlig vejledning og behandlinger tilpasset den enkelte hud. Det princip ændrer vi ikke på i Black Week. Vi har bare samlet et nøje udvalgt sortiment af vores hudplejefavoritter til ekstra gode priser.<\/p><p>Gå på opdagelse blandt effektive produkter, håndplukket af vores kosmetologer og udvalgt ud fra samme faglige tilgang, som vi arbejder med i klinikkerne. Her får du mulighed for at investere i sund, stærk og velfungerende hud, uanset om det er til dig selv eller til årets julegaver.<\/p>","content_width":"sm"},"blocks":{}}},"block_order":["heading_WtdUzz","rich_text_MaEM37"]},"multi_column_column_xpniYH":{"type":"_multi-column-column","settings":{"color_scheme":"scheme-8d0856b4-0efb-4f59-b45e-7e70b861b6d0","text_alignment":"left"},"blocks":{"heading_nCXizc":{"type":"heading","settings":{"text":"<strong>Black Week uden at gå på kompromis med kvaliteten&nbsp;<\/strong>","heading_size":"h5","html_tag":"h3","indent":"none","highlight_effect":"default","highlight_accent_color":"","highlight_text_color":""},"blocks":{}},"rich_text_xQPerd":{"type":"rich-text","settings":{"text":"<p>Black Week handler hos os ikke om at tømme lageret. Det handler om det, der har været kernen i Højholt Hudpleje siden begyndelsen: <strong>faglighed, kvalitet og synlige resultater<\/strong>.<\/p><p>Vi udvælger produkter og brands, som understøtter vores resultatorienterede tilgang til hudpleje, og som vi selv står inde for. Uanset om du ønsker at mindske fine linjer, tilføre fugt og glød eller styrke hudens barriere, kan du finde målrettede produkter, der støtter netop din huds behov, nu til Black Week-priser.<\/p><p>Sig til, hvis trappesatserne eller gavereglen ikke er endeligt på plads for Black Week, så fjerner jeg tallene fra afsnittet.<\/p>","content_width":"sm"},"blocks":{}}},"block_order":["heading_nCXizc","rich_text_xQPerd"]},"multi_column_column_p4HmLM":{"type":"_multi-column-column","settings":{"color_scheme":"scheme-8d0856b4-0efb-4f59-b45e-7e70b861b6d0","text_alignment":"left"},"blocks":{"heading_8xzhnz":{"type":"heading","settings":{"text":"Jo mere du handler, jo mere sparer du&nbsp;","heading_size":"h5","html_tag":"h3","indent":"none","highlight_effect":"default","highlight_accent_color":"","highlight_text_color":""},"blocks":{}},"rich_text_F9KmJe":{"type":"rich-text","settings":{"text":"<p>I Black Week kører vi en trapperabat: Handler du for over 750 kr., sparer du 15 %. Over 1.500 kr. giver 20 %, og over 2.500 kr. giver 25 %. Rabatten trækkes automatisk fra i kurven, og med hvert trin følger en gratis gave.<\/p><p>Gå på opdagelse i vores <strong>Black Week-kategori<\/strong>, og find dine personlige hudplejefavoritter til årets bedste priser. Black Week starter søndag d. 22. november kl. 20.00 og gælder ugen ud, så benyt anledningen til at forkæle din hud, mens tilbuddene gælder.<\/p>","content_width":"sm"},"blocks":{}}},"block_order":["heading_8xzhnz","rich_text_F9KmJe"]},"section-header":{"type":"_section-header","static":true,"settings":{"subheading":"","title":"","content":"","button_text":"","button_link":"","button_style":"outline","text_alignment":"left","heading_size":"h3","title_icon":"none","show_scrolling_title":false},"blocks":{}}},"block_order":["multi_column_column_jHyVML","multi_column_column_xpniYH","multi_column_column_p4HmLM"],"name":"t:sections.multi_column.name","settings":{"color_scheme":"scheme-8d0856b4-0efb-4f59-b45e-7e70b861b6d0","show_internal_borders":false,"add_horizontal_spacing":true,"add_top_spacing":true,"add_bottom_spacing":true,"items_per_row":2,"stack_on_mobile":false,"stack_on_desktop":true,"column_spacing":"md","row_spacing":"md"}},"sticky_button_NaMy89":{"type":"sticky-button","blocks":{"forms_inline_VpEgKb":{"type":"shopify:\/\/apps\/forms\/blocks\/inline\/8744a304-fcb1-4347-b211-bb6b4759a76a","settings":{"form_id":"1236402","text_color":"#f6f6f6","button_background_color":"#ff5005","button_label_color":"#252525","links_color":"#1878b9","errors_color":"#e02229","text_alignment":"center","form_alignment":"center","padding_top":0,"padding_bottom":24,"padding_right":0,"padding_left":0}}},"block_order":["forms_inline_VpEgKb"],"custom_css":[],"name":"Sticky button","settings":{"action":"popup","button_text":"Sign up til VIP her","button_link":"","open_in_new_tab":false,"button_style":"solid","icon":"picto-sparkle","button_b