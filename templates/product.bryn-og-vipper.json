t_color":"","highlight_text_color":""},"blocks":{}}},"block_order":["dynamic_grid_heading_4gVwAh"]}},"block_order":["dynamic_grid_item_mNKcWU","dynamic_grid_item_XDawQx","dynamic_grid_item_9iTNQn","dynamic_grid_item_PaRVBV","dynamic_grid_item_rd896y"],"disabled":true,"name":"t:sections.dynamic_grid.name","settings":{"color_scheme":"scheme-3","allow_transparent_header":true,"show_background_image_parallax":false,"background_video":"shopify:\/\/files\/videos\/video_hojholt_forside.mp4","mobile_background_video":"shopify:\/\/files\/videos\/d61d8f2bc7374b77925a6637442f0353.HD-1080p-7.2Mbps-42870340.mp4","add_vertical_spacing":false,"add_horizontal_spacing":false,"gap":16,"mobile_gap":10,"overlay_color":"#000000","overlay_opacity":20}},"reading_text_hePRXk":{"type":"reading-text","disabled":true,"name":"t:sections.reading_text.name","settings":{"color_scheme":"scheme-4","subheading":"","content":"Denne behandling er skabt til dig som vil have det bedste af det bedste","button_text":"","button_link":"","heading_tag":"h2","mobile_text_position":"place-self-center","desktop_text_position":"sm:place-self-center","content_width":"full","reading_speed":"1.5","separate_button":true,"text_opacity":20,"overlay_color":"#000000","overlay_opacity":20}},"faq_dBbF9J":{"type":"faq","blocks":{"category_qTjE39":{"type":"category","disabled":true,"settings":{"title":"Order","icon":"none","icon_width":24,"mobile_icon_width":20}},"question_fAfzqU":{"type":"question","settings":{"question":"Hvad inkluderer en brynbehandling hos Højholt Hudpleje?","answer":"<p>En brynbehandling inkluderer typisk formning med voks, pincet og\/eller saks, samt farvning tilpasset din hudtone og hårfarve. Vi tilpasser altid formen og farven efter dit ansigt og dine ønsker.<\/p>","icon":"none","icon_width":24,"mobile_icon_width":20}},"question_mQUJXx":{"type":"question","settings":{"question":"Hvordan vælger I farven til mine bryn og vipper?","answer":"<p>Vi vælger farve ud fra din naturlige hårfarve, hudtone og det udtryk, du ønsker. Du bliver altid inddraget i valget, så resultatet passer til dig og dine præferencer.<\/p>","icon":"none","icon_width":24,"mobile_icon_width":20}},"question_iebxMt":{"type":"question","settings":{"question":"Hvor længe holder farvning af bryn og vipper?","answer":"<p>Farven holder typisk i 3–5 uger, afhængigt af din hudtype og hvor ofte du renser området. Farven på vipperne holder ofte lidt længere end på brynene.<\/p>","icon":"none","icon_width":24,"mobile_icon_width":20}},"question_dxwymL":{"type":"question","settings":{"question":"Er behandlingen smertefuld?","answer":"<p>Nej, behandlingen er meget skånsom. Du kan opleve let ubehag ved formning med voks, men det er hurtigt overstået og mildt for huden.<\/p>","icon":"none","icon_width":24,"mobile_icon_width":20}},"question_bkGfCg":{"type":"question","settings":{"question":"Kan jeg få farvet bryn og vipper, hvis jeg er gravid?","answer":"<p>Ja, det kan du som udgangspunkt godt. Vi bruger milde og sikre farver, men du bør altid rådføre dig med os og evt. din læge, hvis du er i tvivl.<\/p>","icon":"none","icon_width":24,"mobile_icon_width":20}},"question_FnhYhR":{"type":"question","settings":{"question":"Hvad skal jeg undgå efter behandlingen?","answer":"<p>Vi anbefaler at undgå makeup, olieprodukter og overdreven fugt omkring bryn og vipper de første 24 timer efter behandlingen. Dette forlænger både holdbarhed og intensitet af farven.<\/p>","icon":"none","icon_width":24,"mobile_icon_width":20}}},"block_order":["category_qTjE39","question_fAfzqU","question_mQUJXx","question_iebxMt","question_dxwymL","question_bkGfCg","question_FnhYhR"],"name":"t:sections.faq.name","settings":{"color_scheme":"","layout":"split","accordion_style":"border","question_style":"text","subheading":"Har du brug for yderligere hjælp? Fang os på +45 61 33 18 38","title":"Oftest stillede spørgsmål","title_tag":"h3","content":"","button_text":"","button_url":"","button_style":"solid"}}},"order":["main","scrolling_content_DGW