rue,"settings":{"subheading":"","title":"Multi-column","content":"<p>Use this content to share information about your store and products.<\/p>","button_text":"","button_link":"","button_style":"outline","text_alignment":"left","heading_size":"h3","title_icon":"none","show_scrolling_title":false},"blocks":{}}},"block_order":["multi_column_column_WDfFdt","multi_column_column_XiVL3F","multi_column_column_8WjCFy","multi_column_column_VNHbjn","multi_column_column_Gn9eby","multi_column_column_hcNBGp"],"custom_css":[".multi-column__item.color-scheme.color-scheme--scheme-7.group.snap-start {background-color: #500100; border-radius: 15px;}"],"name":"t:sections.multi_column.name","settings":{"color_scheme":"scheme-5dd1f738-7ea5-42bb-bf8a-49acc13d8213","show_internal_borders":false,"add_horizontal_spacing":true,"add_top_spacing":true,"add_bottom_spacing":true,"items_per_row":3,"stack_on_mobile":false,"stack_on_desktop":true,"column_spacing":"md","row_spacing":"md"}},"rich_text_dWPDLy":{"type":"rich-text","blocks":{"button_8kJA3f":{"type":"button","settings":{"text":"SE ALLE TILBUD","url":"https:\/\/www.hoejholthudpleje.dk\/collections\/team-dr-joseph","open_in_new_tab":false,"style":"solid","background":"","text_color":""}}},"block_order":["button_8kJA3f"],"name":"t:sections.rich_text.name","settings":{"color_scheme":"scheme-5dd1f738-7ea5-42bb-bf8a-49acc13d8213","content_width":"md","text_alignment":"center"}},"multi_column_3RxTRk":{"type":"multi-column","blocks":{"multi_column_column_jHyVML":{"type":"_multi-column-column","settings":{"color_scheme":"scheme-5dd1f738-7ea5-42bb-bf8a-49acc13d8213","text_alignment":"left"},"blocks":{"heading_WtdUzz":{"type":"heading","settings":{"text":"Fejr 10 års jubilæum med eksklusive tilbud på professionel hudpleje","heading_size":"h4","html_tag":"h2","indent":"none","highlight_effect":"default","highlight_accent_color":"","highlight_text_color":""},"blocks":{}},"rich_text_MaEM37":{"type":"rich-text","settings":{"text":"<p>Hos Højholt Hudpleje fejrer vi <strong>10 års jubilæum<\/strong> – og det vil vi gerne fejre sammen med dig. I 10 år har vi haft fokus på resultatorienteret hudpleje, personlig vejledning og behandlinger tilpasset den enkelte hud. Derfor har vi i anledning af jubilæet samlet et nøje udvalgt sortiment af vores hudplejefavoritter til ekstra gode priser.<\/p><p>Gå på opdagelse blandt effektive produkter, håndplukket af vores kosmetologer og nøje udvalgt ud fra samme faglige tilgang, som vi arbejder med i klinikkerne. Her får du mulighed for at investere i sund, stærk og velfungerende hud – og samtidig fejre 10 år med Højholt Hudpleje sammen med os.<\/p>","content_width":"sm"},"blocks":{}}},"block_order":["heading_WtdUzz","rich_text_MaEM37"]},"multi_column_column_xpniYH":{"type":"_multi-column-column","settings":{"color_scheme":"scheme-5dd1f738-7ea5-42bb-bf8a-49acc13d8213","text_alignment":"left"},"blocks":{"heading_nCXizc":{"type":"heading","settings":{"text":"Jubilæumstilbud – uden at gå på kompromis med kvaliteten","heading_size":"h5","html_tag":"h3","indent":"none","highlight_effect":"default","highlight_accent_color":"","highlight_text_color":""},"blocks":{}},"rich_text_xQPerd":{"type":"rich-text","settings":{"text":"<p>Vores 10 års jubilæum handler ikke kun om gode tilbud. Det handler også om det, der har været kernen i Højholt Hudpleje siden begyndelsen: <strong>faglighed, kvalitet og synlige resultater<\/strong>.<\/p><p>Vi udvælger produkter og brands, som understøtter vores resultatorienterede tilgang til hudpleje, og som vi selv står inde for. Uanset om du ønsker at mindske fine linjer, tilføre fugt og glød eller styrke hudens barriere, kan du finde målrettede produkter, der støtter netop din huds behov.<\/p>","content_width":"sm"},"blocks":{}}},"block_order":["heading_nCXizc","rich_text_xQPerd"]},"multi_column_column_p4HmLM":{"type":"_multi-column-column","settings":{"color_scheme":"scheme-5dd1f738-7ea5-42bb-bf8a-49acc13d8213","text_alignment":"left"},"blocks":{"heading_8xzhnz":{"type":"heading","settings":{"text":"Fejr 10 år med os – og forkæl din hud","heading_size":"h5","html_tag":"h3","indent":"none","highlight_effect":"default","highlight_accent_color":"","highlight_text_color":""},"blocks":{}},"rich_text_F9KmJe":{"type":"rich-text","settings":{"text":"<p>Når du handler hos Højholt Hudpleje, får du mere end et godt jubilæumstilbud. Du får 10 års erfaring, faglig vejledning og nøje udvalgte produkter, der er skabt til at gøre en reel forskel for din hud.<\/p><p>Gå på opdagelse i vores <strong>10 års jubilæumskategori<\/strong>, og find dine personlige hudplejefavoritter til særlige jubilæumspriser. Tilbuddene gælder kun i en begrænset periode – så benyt anledningen til at forkæle din hud og være med til at fejre vores første 10 år.<\/p>","content_width":"sm"},"blocks":{}}},"block_order":["heading_8xzhnz","rich_text_F9KmJe"]},"section-header":{"type":"_section-header","static":true,"settings":{"subheading":"","title":"","content":"","button_text":"","button_link":"","button_style":"outline","text_alignment":"left","heading_size":"h3","title_icon":"none","show_scrolling_title":false},"blocks":{}}},"block_order":["multi_column_column_jHyVML","multi_column_column_xpniYH","multi_column_column_p4HmLM"],"name":"t:sections.multi_column.name","settings":{"color_scheme":"scheme-5dd1f738-7ea5-42bb-bf8a-49acc13d8213","show_internal_borders":false,"add_horizontal_spacing":true,"add_top_spacing":true,"add_bottom_spacing":true,"items_per_row":2,"stack_on_mobile":false,"stack_on_desktop":true,"column_spacing":"md","row_spacing":"md"}},"sticky_button_NaMy89":{"type":"sticky-button","blocks":{"forms_inline_VpEgKb":{"type":"shopify:\/\/apps\/forms\/blocks\/inline\/8744a304-fcb1-4347-b211-bb6b4759a76a","settings":{"form_id":"1128290","text_color":"#f53a3b","button_background_color":"#f53a3b","button_label_color":"#ffffff","links_color":"#1878b9","errors_color":"#e02229","text_alignment":"center","form_alignment":"center","padding_top":0,"padding_bottom":