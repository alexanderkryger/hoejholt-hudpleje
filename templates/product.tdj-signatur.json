_terms","separator","description","modal_PHjBwx","button_4H83gP","button_4rbjfG","icons_with_text_jDPynd"],"custom_css":["a.button.button--outline.w-full {margin-top: -20px;}"],"settings":{"color_scheme":"","allow_transparent_header":false,"transparent_header_use_primary_colors":false,"add_top_spacing":true,"show_sticky_add_to_cart":false,"product_media_size":50,"content_alignment":"left","desktop_media_layout":"grid_half_highlight_first","desktop_carousel_controls":"lines","mobile_controls":"lines","enable_media_autoplay":true,"enable_video_looping":true,"enable_image_zoom":true,"max_image_zoom_level":3}},"scrolling_content_DGWJyH":{"type":"scrolling-content","blocks":{"text_nJFQQT":{"type":"text","settings":{"text":"{{ product.title }}","icon_position":"before_text","highlight_effect":"default","highlight_accent_color":"","highlight_text_color":""}}},"block_order":["text_nJFQQT"],"name":"t:sections.scrolling_content.name","settings":{"color_scheme":"scheme-4","scrolling_speed":0.2,"scroll_direction":"start-to-end","section_rotation":0,"pause_on_hover":false,"text_font":"heading","text_font_size_mobile":10,"text_font_size_desktop":7,"section_vertical_spacing_mobile":24,"section_vertical_spacing_desktop":60,"item_horizontal_spacing_mobile":40,"item_horizontal_spacing_desktop":80}},"timeline_Nqarx3":{"type":"timeline","blocks":{"item_xTxdmp":{"type":"item","settings":{"image":"shopify:\/\/shop_images\/team-dr-josepg-signatur-ansigtsbehandling-3.jpg","label":"Beskrivelse","subheading":"","icon":"none","icon_width":32,"mobile_icon_width":24,"title":"Velvære, balance og naturlig glød","price":"","heading_tag":"h5","price_heading_tag":"h3","highlight_effect":"default","content":"<p>Team Dr. Joseph Signatur er en holistisk ansigtsbehandling, der forener avanceret hudpleje med manuelle teknikker og plantebaserede produkter. Med fokus på vejrtrækning, lymfestimulering, cupping og massage afspændes ansigtsmuskulaturen, nervesystemet beroliges og huden balanceres i dybden.<\/p><p>Behandlingen er ideel for alle hudtyper og giver både rens, ro og fornyet glød. Huden fremstår mere jævn, porerne virker raffinerede, og du går herfra med en oplevelse af total velvære – både i hud og sind.<\/p>","button_label":"Book behandling","button_link":"shopify:\/\/pages\/booking","button_style":"solid"}},"item_qqB3jT":{"type":"item","settings":{"image":"shopify:\/\/shop_images\/team-dr-josepg-signatur-ansigtsbehandling-4.jpg","label":"Behandlingen indeholder","subheading":"","icon":"none","icon_width":32,"mobile_icon_width":24,"title":"Behandlingen indeholder:","price":"","heading_tag":"h5","price_heading_tag":"h3","highlight_effect":"default","content":"{{ product.metafields.custom.indeholder | metafield_tag }}","button_label":"Book behandling","button_link":"shopify:\/\/pages\/booking","button_style":"solid"}},"item_GGq3zA":{"type":"item","settings":{"image":"shopify:\/\/shop_images\/team-dr-josepg-signatur-ansigtsbehandling-1.jpg","label":"Behandlingstid","subheading":"","icon":"none","icon_width":32,"mobile_icon_width":24,"title":"Varighed: {{ product.metafields.custom.behandlingstid.value }}","price":"","heading_tag":"h5","price_heading_tag":"h3","highlight_effect":"default","content":"<p>Behandlingen tager cirka {{ product.metafields.custom.behandlingstid.value }} og tilpasses altid din huds aktuelle behov.<\/p>","button_label":"Book behandling","button_link":"shopify:\/\/pages\/booking","button_style":"solid"}},"item_6TiVyF":{"type":"item","settings":{"image":"shopify:\/\/shop_images\/phformula-ansigtsbehandling-4.jpg","label":"Tillæg","subheading":"","icon":"none","icon_width":32,"mobile_icon_width":24,"title":"Oftest valgte tillæg","price":"","heading_tag":"h5","price_heading_tag":"h3","highlight_effect":"default","content":"<ul><li>**Beauty angel: 200 kr.<\/li><li>**Halsbehandling: 125 kr.<\/li><li>**Hovedbundsmassage: 125 kr.<\/li><\/ul>","button_label":"Booking","button_link":"shopify:\/\/pages\/booking","button_style":"solid"}}},"block_order":["item_xTxdmp","item_qqB3jT","item_GGq3zA","item_6TiVyF"],"name":"t:sections.timeline.name","settings":{"color_scheme":"scheme-4","timeline_position":"top","image_position":"right","text_alignment":"left","add_image_spacing":true}},"press_AUTUHM":{"type":"press","blocks":{"item_DtBVFq":{"type":"item","settings":{"logo_width":80,"author":"Charlotte","content":"Jeg nyder altid mine timer hos Højholt i Silkeborg, det er rart, trygt og de er professionelle."}},"item_ipAJiC":{"type":"item","settings":{"logo_width":80,"author":"Astrid","content":"En time i spahimlen. Kan anbefale alle at forkæle sig selv med et besøg hos Højholt."}},"item_ePM7yq":{"type":"item","settings":{"logo_width":80,"author":"Rebekka","content":"Dygtige og kompetente hænder gennem hele behandlingen. En meget fin oplevelse- som altid."}}},"block_order":["item_DtBVFq","item_ipAJiC","item_ePM7yq"],"name":"t:sections.press.name","settings":{"color_scheme":"","title":"","use_arrows_navigation":false,"show_quotation_mark":true,"quotation_tag":"h3","item_style":"avatar","autoplay":true,"cycle_speed":6,"overlay_color":"#000000","overlay_opacity":20}},"text_with_media_ULXhFg":{"type":"text-with-media","blocks":{"subheading_w6NLrR":{"type":"subheading","settings":{"text":"Prisvindende & prisnominderede skønhendsklinik","position":"top_center"}},"heading_4apn4V":{"type":"heading","settings":{"text":"<em>Prisvindende<\/em> hudplejeklinik","heading_tag":"display-l","position":"middle_center","highlight_effect":"tilted_marker","highlight_accent_color":"#fbf0e8","highlight_text_color":"#a58475"}},"richtext_Y9iaEF":{"type":"richtext","settings":{"text":"<p>Hos Højholt Hudpleje arbejder vi hver dag målrettet for at give dig resultater, der kan mærkes og ses. Derfor er vi ekstra stolte over at være kåret som regionsvinder ved Danmarks Bedste Awards 2024.<\/p>","position":"bottom_center"}}},"block_order":["subheading_w6NLrR","heading_4apn4V","richtext_Y9iaEF"],"custom_css":[".placement-grid.span-full {padding-top: 3rem; padding-bottom: 3rem;}",".content-box__background-media img {border-radius: 20px;}"],"name":"t:sections.text_with_media.name","settings":{"color_scheme":"scheme-5","content_position":"start","content_percentage_width":50,"overlay_color":"#000000","overlay_opacity":20,"add_media_spacing":true,"autoplay_video":true,"primary_image":"shopify:\/\/shop_images\/ansigtsbehandling_billede_1.jpg","secondary_image":"shopify:\/\/shop_images\/Beautysted_RV_Sticker_-_Hojholt_Hudpleje_2d763b57-50d0-4b03-87ee-2f8889b8fd8b.png","secondary_media_width":40,"secondary_media_mobile_width":40,"show_secondary_media_on_mobile":true,"secondary_media_alignment":"place-self-end","secondary_media_shape":"none"}},"reading_text_hePRXk":{"type":"reading-text","disabled":true,"name":"t:sections.reading_text.name","settings":{"color_scheme":"scheme-4","subheading":"","content":"Denne behandling er skabt til dig som vil have det bedste af det bedste","button_text":"","button_link":"","heading_tag":"h2","mobile_text_position":"place-self-center","desktop_text_position":"sm:place-self-center","content_width":"full","reading_speed":"1.5","separate_button":true,"text_opacity":20,"overlay_color":"#000000","overlay_opacity":20}},"faq_dBbF9J":{"type":"faq","blocks":{"category_qTjE39":{"type":"category","disabled":true,"settings":{"title":"Order","icon":"none","icon_width":24,"mobile_icon_width":20}},"question_8p6WLj":{"type":"question","settings":{"question":"Hvem passer behandlingen til?","answer":"<p>Behandlingen er ideel til alle hudtyper – især dig, der ønsker både synlige resultater og en sanselig oplevelse med ro og fordybelse.<\/p>","icon":"none","icon_width":24,"mobile_icon_width":20}},"question_g7yer3":{"type":"question","settings":{"question":"Er der fokus på resultater eller velvære?","answer":"<p>Begge dele. Signaturbehandlingen balancerer huden i dybden med effektive urteingredienser og teknikker som cupping og lymfestimulering – samtidig med, at du opnår fuld afspænding og ro.<\/p>","icon":"none","icon_width":24,"mobile_icon_width":20}},"question_mBnYGe":{"type":"question","settings":{"question":"Er der dybderens med i behandlingen?","answer":"<p>Ja, hvis din hud har behov for det. Vi vurderer altid undervejs og tilpasser behandlingen, så den matcher din huds aktuelle tilstand.<\/p>","icon":"none","icon_width":24,"mobile_icon_width":20}},"question_CTp6nE":{"type":"question","settings":{"question":"Hvad er forskellen på denne og Supreme Eye & FaceLift?","answer":"<p>Signatur er helhedsorienteret med fokus på hele ansigtet og kroppen som helhed. Supreme har et ekstra løftende og målrettet fokus på øjenområdet og ansigtskonturerne.<\/p>","icon":"none","icon_width":24,"mobile_icon_width":20}},"question_Kh7yf7":{"type":"question","settings":{"question":"Hvor ofte kan man få behandlingen?","answer":"<p>Du kan få den som en luksuriøs enkeltbehandling eller som fast selvpleje. Den kan gentages regelmæssigt uden risiko for overstimulering.<\/p>","icon":"none","icon_width":24,"mobile_icon_width":20}},"question_bkGfCg":{"type":"question","settings":{"question":"Er der parkering ved klinikken?","answer":"<p><strong>Aarhus:<br\/><\/strong>Vores klinik på Langelandsgade i Århus ligger blot 100 meter fra Stjernepladsen, hvor Letbanen stopper. Udover Letbanen kører flere busser tæt på adressen. Der er kun 300 meter fra Universitets Parken. Hvis du kommer i bil, kan du parkere lige foran klinikken gratis. Der finder du både parkeringsbåse og parallelparkering.<br\/><br\/><strong>Silkeborg:<\/strong><br\/>I Silkeborg ligger vores klinik på gågaden men vi har heldigvis mange forskellige parkeringsmuligheder. I Silkeborg midtby kan du parkere 1 time gratis ved indcheckning via parkerings app, eksempelvis easypark. Herefter koster det 15 kr,.\/timen. Parkeringsmulighederne der er nemme at komme til og højest 4 minutters gang fra klinikken er: Bindslevs Plads parkeringskælder, Bios Gård eller Mejerigården.<\/p>","icon":"none","icon_width":24,"mobile_icon_width":20}}},"block_order":["category_qTjE39","question_8p6WLj","question_g7yer3","question_mBnYGe","question_CTp6nE","question_Kh7yf7","question_bkGfCg"],"name":"t:sections.faq.name","settings":{"color_scheme":"","layout":"split","accordion_style":"border","question_style":"text","subheading":"Har du brug for yderligere hjælp? Fang os på +45 61 33 18 38","title":"Oftest stillede spørgsmål","title_tag":"h3","content":"","button_text":"","button_url":"","button_style":"solid"}}},"order":["main","scrolling_content_DGWJyH","timeline_Nqarx3","press_AUTUHM","text_with_media_ULXhFg","reading_text_hePRXk","faq_dBbF9J"]}