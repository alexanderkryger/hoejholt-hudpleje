i lavet en eksklusiv trapperabat, hvor du sparer mere – jo flere af dine favoritprodukter du lægger i kurven.<br\/><br\/>Det betyder, at jo flere favoritprodukter du investerer i, enten til dig selv eller til årets julegaver, jo større en rabat kan vi tilbyde på din samlede ordre.<br\/>Når du lægger dine produkter i kurven, bliver rabatten automatisk fratrukket prisen<br\/><br\/>Black Week starter den 23. november kl 20.00 for alle VIP. For alle andre åbner siden mandag d. 24 november, så tilmeld dig VIP, hvis du skal først i køen.<\/p>","position":"top_left"}},"button_MBwC6U":{"type":"button","disabled":true,"settings":{"text":"Tilmeld dig VIP","url":"#shopify-section-template--25878435135812__1762371096ee4534d1","position":"top_left","style":"solid","background":"#f6a429","text_color":"#ffffff"}}},"block_order":["subheading_q8P43D","heading_THeDMe","richtext_LAk8eC","button_MBwC6U"],"custom_css":["img {border-radius: 15px;}"],"name":"t:sections.text_with_media.name","settings":{"color_scheme":"scheme-4","content_position":"end","content_percentage_width":40,"overlay_color":"#000000","overlay_opacity":0,"add_media_spacing":true,"autoplay_video":false,"primary_image":"shopify:\/\/shop_images\/hh_tilbudstige-3.jpg","secondary_media_width":60,"secondary_media_mobile_width":60,"show_secondary_media_on_mobile":true,"secondary_media_alignment":"place-self-center","secondary_media_shape":"none"}},"featured_collections_ifAYMt":{"type":"featured-collections","blocks":{"collection_9xttgL":{"type":"collection","settings":{"collection":"team-dr-joseph","products_count":10,"title":"{{ block.settings.collection.title }}","content":"<h6>Eksklusive rabatter fra Team Dr. Joseph til Black VIP søndag d. 23\/11 kl. 20.00<\/h6>","link":"{{ block.settings.collection.url }}"}},"collection_FUjQUq":{"type":"collection","settings":{"collection":"phformula","products_count":10,"title":"{{ block.settings.collection.title }}","content":"<h6>Eksklusive rabatter fra pHformula til Black VIP sønda