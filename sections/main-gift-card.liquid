<style>
  @media print {
    @page {
      margin: 0;
    }

    html,
    body {
      margin: 0;
      padding: 0;
      background: none;
    }

    .shopify-section:not(.shopify-section--main-gift-card),
    .section-split__column--image,
    .gift-card__action-buttons,
    .gift-card__apple-wallet {
      display: none !important;
    }

    .shopify-section--main-gift-card > .color-scheme {
      box-sizing: border-box;
      height: 100vh;
      display: grid;
      grid-template-rows: auto minmax(0, 1fr) auto;
      overflow: hidden;
      break-inside: avoid;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }
    .shopify-section--main-gift-card .gift-card__print-header {
      display: block !important;
    }

    .shopify-section--main-gift-card .gift-card__print-header-image {
      display: block;
      width: 100%;
      height: var(--print-header-height, 220px);
      object-fit: cover;
    }

    .shopify-section--main-gift-card .section-split {
      display: grid;
      align-content: center;
      min-height: 0 !important;
      min-block-size: 0 !important;
      height: auto !important;
      padding: 2cm;
    }

    .shopify-section--main-gift-card .gift-card {
      height: auto;
    }

    .shopify-section--main-gift-card .gift-card__print-heading {
      display: block !important;
    }

    .shopify-section--main-gift-card .gift-card__print-logo {
      width: var(--print-logo-width, 160px);
      max-width: 100%;
      height: auto;
      margin-inline: auto;
    }

    .shopify-section--main-gift-card .gift-card__print-footer {
      display: flex !important;
      flex-wrap: wrap;
      justify-content: center;
      align-items: center;
      gap: 2rem;
      padding: 1.5cm 2cm;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    .shopify-section--main-gift-card .gift-card__print-badge {
      width: var(--print-badge-width, 140px);
      max-width: 100%;
      height: auto;
    }

    .shopify-section--main-gift-card .gift-card__code {
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }
  }
</style>

<div class="color-scheme color-scheme--{{ section.settings.content_color_scheme.id }}">
  {%- if section.settings.print_image != blank -%}
    {%- capture print_header_style -%}--print-header-height: {{ section.settings.print_image_height }}px{%- endcapture -%}
    <div class="gift-card__print-header" style="{{ print_header_style }}" hidden>
      {{- section.settings.print_image | image_url: width: 1600 | image_tag: loading: 'eager', sizes: '800px', widths: '800,1200,1600', class: 'gift-card__print-header-image' -}}
    </div>
  {%- endif -%}

  <div class="section-split sm:min-h-fill">
    <div class="section-split__column section-split__column--image section-split__column--flushed">
      <div class="content-box h-full min-h-xs color-scheme color-scheme--{{ section.settings.image_color_scheme.id }}">
        {%- if section.settings.background_image != blank -%}
          <div class="content-box__background-media">
            {{- section.settings.background_image | image_url: width: section.settings.background_image.width | image_tag: sizes: '(max-width: 699px) 100vw, 50vw', widths: '200,300,400,600,800,1000,1200,1400,1600,1800,2000' -}}
          </div>
        {%- endif -%}

        <div class="column-span-full align-self-center">
          {%- if section.settings.show_scrolling_title -%}
            <marquee-text speed="0.1" direction="start-to-end" class="scrolling-content">
              <div class="scrolling-content__item" style="font-size: var(--text-h1)">
                <h1 class="h1">{{ 'gift_card.general.title' | t }}</h1>
              </div>
            </marquee-text>
          {%- else -%}
            <h1 class="sr-only">{{ 'gift_card.general.title' | t }}</h1>
          {%- endif -%}
        </div>
      </div>
    </div>

    <div class="section-split__column align-self-stretch">
      <div class="gift-card">
        <div class="v-stack gap-6">
          <div class="gift-card__print-heading" hidden>
            {%- if section.settings.print_logo != blank -%}
              {%- capture print_logo_style -%}--print-logo-width: {{ section.settings.print_logo_width }}px{%- endcapture -%}
              {{- section.settings.print_logo | image_url: width: section.settings.print_logo.width | image_tag: loading: 'eager', sizes: '300px', widths: '200,400,600', class: 'gift-card__print-logo', style: print_logo_style -}}
            {%- else -%}
              <p class="h3">{{ shop.name }}</p>
            {%- endif -%}
          </div>

          <!-- EXPIRE BANNER -->
          {%- if gift_card.expired or gift_card.enabled == false -%}
            {%- assign banner_error = 'gift_card.issued.expired' | t -%}
            {%- render 'banner', status: 'error', content: banner_error -%}
          {%- endif -%}

          <div class="v-stack gap-4">
            <!-- REMAINING BALANCE -->
            <p class="subheading">{{ 'gift_card.issued.remaining_amount' | t }}</p>

            {% if settings.currency_code_enabled %}
              {%- assign gift_card_balance = gift_card.balance | money_with_currency -%}
              {%- assign gift_card_initial_value = gift_card.initial_value | money_with_currency -%}
            {% else %}
              {%- assign gift_card_balance = gift_card.balance | money -%}
              {%- assign gift_card_initial_value = gift_card.initial_value | money -%}
            {% endif %}

            <p class="h1">{{ gift_card_balance }}</p>

            {%- if gift_card.balance != gift_card.initial_value -%}
              <p class="subheading">{{ 'gift_card.issued.out_of_html' | t: initial_value: gift_card_initial_value }}</p>
            {%- endif -%}
          </div>

          <!-- REDEEM INFO -->
          <p>{{ 'gift_card.issued.redeem_instructions' | t }}</p>

          <!-- ACTION BUTTONS -->
          <div class="v-stack gap-3">
            <input class="input gift-card__code" type="text" value="{{ gift_card.code | format_code }}" readonly aria-label="{{ 'gift_card.issued.code' | t }}" onclick="this.select()">

            <div class="gift-card__action-buttons">
              <copy-button class="contents" data-text="{{ gift_card.code | escape }}">
                {%- assign button_content = 'gift_card.general.copy' | t -%}
                {%- render 'button', content: button_content -%}
              </copy-button>

              <button type="button" class="button button--outline" style="--button-text-color: var(--button-background-primary)" onclick="window.print()">
                <button-content class="button__content" rotated-text="{{ 'gift_card.general.print' | t | escape }}">
                  {{ 'gift_card.general.print' | t }}
                </button-content>
              </button>
            </div>
          </div>

          {%- if gift_card.expires_on -%}
            {%- assign expires_on = gift_card.expires_on | date: format: 'date' -%}
            <p class="subheading">{{ 'gift_card.issued.expires_on' | t: expires_on: expires_on }}</p>
          {%- endif -%}
        </div>

        {%- if gift_card.pass_url or section.settings.show_qr_code -%}
          <div class="gift-card__pass-cards">
            <!-- QR CODE AND APPLE PAY -->
            {%- if section.settings.show_qr_code -%}
              <qr-code class="gift-card__qr-code" identifier="{{ gift_card.qr_identifier }}"></qr-code>
            {%- endif -%}

            {%- if gift_card.pass_url -%}
              <a class="gift-card__apple-wallet" href="{{ gift_card.pass_url }}">
                <img src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}" width="145" height="45" alt="{{ 'gift_card.issued.add_to_apple_wallet' | t }}" loading="lazy">
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>

  {%- capture print_badges -%}
    {%- for i in (1..3) -%}
      {%- assign badge_setting = 'print_badge_' | append: i -%}

      {%- if section.settings[badge_setting] != blank -%}
        {{- section.settings[badge_setting] | image_url: width: 600 | image_tag: loading: 'eager', sizes: '200px', widths: '200,400,600', class: 'gift-card__print-badge' -}}
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}

  {%- if print_badges != blank -%}
    {%- capture print_footer_style -%}--print-badge-width: {{ section.settings.print_badge_width }}px{%- endcapture -%}
    <div class="gift-card__print-footer color-scheme color-scheme--{{ section.settings.print_footer_color_scheme.id }}" style="{{ print_footer_style }}" hidden>
      {{- print_badges -}}
    </div>
  {%- endif -%}
</div>

<script>
  if (new URLSearchParams(window.location.search).has('print')) {
    window.addEventListener('load', () => {
      document.fonts.ready.then(() => {
        setTimeout(() => window.print(), 300);
      });
    });
  }
</script>

{% schema %}
{
  "name": "t:sections.main_gift_card.name",
  "class": "shopify-section--main-gift-card",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "image_color_scheme",
      "label": "t:sections.main_gift_card.image_color_scheme",
      "default": "scheme-4"
    },
    {
      "type": "color_scheme",
      "id": "content_color_scheme",
      "label": "t:sections.main_gift_card.content_color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:global.image.background_image",
      "info": "t:sections.main_gift_card.background_image_size_recommendation"
    },
    {
      "type": "checkbox",
      "id": "show_scrolling_title",
      "label": "t:sections.media_blocks.show_scrolling_title",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_qr_code",
      "label": "t:sections.main_gift_card.show_qr_code",
      "default": true
    },
    {
      "type": "header",
      "content": "Print: header"
    },
    {
      "type": "image_picker",
      "id": "print_image",
      "label": "Headerbillede",
      "info": "Vises i fuld bredde øverst, når gavekortet udskrives. Liggende format anbefales."
    },
    {
      "type": "range",
      "id": "print_image_height",
      "label": "Headerhøjde",
      "min": 80,
      "max": 400,
      "step": 10,
      "unit": "px",
      "default": 220,
      "visible_if": "{{ section.settings.print_image != blank }}"
    },
    {
      "type": "image_picker",
      "id": "print_logo",
      "label": "Logo",
      "info": "Vises over beløbet. Hvis tomt, vises butiksnavnet."
    },
    {
      "type": "range",
      "id": "print_logo_width",
      "label": "Logobredde",
      "min": 80,
      "max": 300,
      "step": 10,
      "unit": "px",
      "default": 160
    },
    {
      "type": "header",
      "content": "Print: footer",
      "info": "Diplomer vises i en farvet bund nederst på det udskrevne gavekort. Op til 3 stk."
    },
    {
      "type": "color_scheme",
      "id": "print_footer_color_scheme",
      "label": "Footer farveskema",
      "default": "scheme-4"
    },
    {
      "type": "image_picker",
      "id": "print_badge_1",
      "label": "Diplom 1"
    },
    {
      "type": "image_picker",
      "id": "print_badge_2",
      "label": "Diplom 2"
    },
    {
      "type": "image_picker",
      "id": "print_badge_3",
      "label": "Diplom 3"
    },
    {
      "type": "range",
      "id": "print_badge_width",
      "label": "Diplombredde",
      "min": 60,
      "max": 240,
      "step": 10,
      "unit": "px",
      "default": 140
    }
  ]
}
{% endschema %}