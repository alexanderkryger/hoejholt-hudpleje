{%- liquid
  assign alignment = section.settings.text_alignment | replace: 'left', 'start' | replace: 'right', 'end'
  assign tier_alignment = section.settings.tier_text_alignment | replace: 'left', 'start' | replace: 'right', 'end'
  assign tiers_per_row_desktop = section.settings.tiers_per_row_desktop | at_most: section.blocks.size | at_least: 1
  assign tiers_per_row_mobile = section.settings.tiers_per_row_mobile | at_most: section.blocks.size | at_least: 1
-%}

<style>
  #shopify-section-{{ section.id }} {
    {%- if section.settings.content_position == 'start' -%}
      --section-split-grid-template-columns: minmax(0, {{ 100 | minus: section.settings.content_percentage_width | divided_by: 100.0 }}fr) minmax(0, {{ section.settings.content_percentage_width | divided_by: 100.0 }}fr);
    {%- else -%}
      --section-split-grid-template-columns: minmax(0, {{ section.settings.content_percentage_width | divided_by: 100.0 }}fr) minmax(0, {{ 100 | minus: section.settings.content_percentage_width | divided_by: 100.0 }}fr);
    {%- endif -%}

    --discount-tiers-grid-template-columns: repeat({{ tiers_per_row_mobile }}, minmax(0, 1fr));
    --discount-tiers-row-gap: 1.25rem;
    --discount-tiers-column-gap: 1.25rem;

    {%- if section.settings.value_color != blank and section.settings.value_color != 'rgba(0,0,0,0)' -%}
      --discount-tiers-value-color: {{ section.settings.value_color.rgb }};
    {%- endif -%}
  }

  #shopify-section-{{ section.id }} + .shopify-section {
    --section-enable-padding-collapsing: 0; /* We turn off the padding collapsing on next section */
  }

  @media screen and (min-width: 700px) {
    #shopify-section-{{ section.id }} {
      --discount-tiers-grid-template-columns: repeat({{ tiers_per_row_desktop }}, minmax(0, 1fr));
      --discount-tiers-row-gap: 2rem;
      --discount-tiers-column-gap: 1.75rem;
    }
  }

  {%- if section.settings.show_separators -%}
    {%- if tiers_per_row_mobile > 1 -%}
      @media screen and (max-width: 699px) {
        #shopify-section-{{ section.id }} .discount-tiers__item:not(:nth-child({{ tiers_per_row_mobile }}n)):not(:last-child) {
          border-inline-end-width: 1px;
        }
      }
    {%- else -%}
      @media screen and (max-width: 699px) {
        #shopify-section-{{ section.id }} .discount-tiers__item:not(:first-child) {
          border-block-start-width: 1px;
        }
      }
    {%- endif -%}

    @media screen and (min-width: 700px) {
      #shopify-section-{{ section.id }} .discount-tiers__item:not(:nth-child({{ tiers_per_row_desktop }}n)):not(:last-child) {
        border-inline-end-width: 1px;
      }
    }
  {%- endif -%}

  /* Structural rules. Move them to assets/theme.css if you reuse this section on several templates. */
  .discount-tiers {
    display: grid;
    grid-template-columns: var(--discount-tiers-grid-template-columns);
    gap: var(--discount-tiers-row-gap) var(--discount-tiers-column-gap);
  }

  .discount-tiers--separated {
    gap: 0;
  }

  .discount-tiers--separated .discount-tiers__item {
    padding: calc(var(--discount-tiers-row-gap) / 2) var(--discount-tiers-column-gap);
  }

  .discount-tiers__value {
    align-items: baseline;
    column-gap: 0.5rem;
    display: flex;
    flex-wrap: wrap;
  }

  .discount-tiers__value-amount {
    color: rgb(var(--discount-tiers-value-color, var(--text-color)));
  }

  .discount-tiers-card {
    border-radius: min(12px, var(--button-border-radius));
    overflow: hidden;
  }
</style>

<div class="color-scheme color-scheme--{{ section.settings.color_scheme.id }}">
  <div class="section-split {% if section.settings.content_position == 'end' %}section-split--reverse{% endif %}">
    {%- comment -%}
    CONTENT PART
    {%- endcomment -%}

    <div class="section-split__column">
      <div class="prose prose-justify-{{ section.settings.text_alignment }}">
        <div class="max-w-sm">
          {%- render 'subheading', content: section.settings.subheading -%}
          {%- render 'heading', content: section.settings.title, balance_text: true, style: section.settings.heading_size, html_tag: 'h2' -%}
        </div>

        {%- if section.settings.content != blank -%}
          <div class="max-w-sm">
            {{- section.settings.content -}}
          </div>
        {%- endif -%}

        {%- render 'button',
          content: section.settings.button_text,
          href: section.settings.button_link,
          style: section.settings.button_style
        -%}
      </div>
    </div>

    {%- comment -%}
    TIERS PART
    {%- endcomment -%}

    <div class="section-split__column section-split__column--image {% unless section.settings.add_card_spacing %}section-split__column--flushed{% endunless %} @container/content-box">
      <div class="discount-tiers-card content-box h-full min-h-{{ section.settings.card_size }} color-scheme color-scheme--{{ section.settings.card_color_scheme.id }}">
        {%- if section.settings.image != blank -%}
          <div class="content-box__background-media with-overlay" style="--overlay: {{ section.settings.overlay_color.rgb }} / {{ section.settings.overlay_opacity | divided_by: 100.0 }}">
            {%- render 'media' with section.settings.image, mobile_media: section.settings.mobile_image, sizes: '(max-width: 999px) 100vw, 50vw' -%}
          </div>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <div class="align-self-center">
            <div class="discount-tiers {% if section.settings.show_separators %}discount-tiers--separated{% endif %}">
              {%- for block in section.blocks -%}
                <div class="discount-tiers__item" {{ block.shopify_attributes }}>
                  <div class="v-stack gap-3 justify-items-{{ tier_alignment }} text-{{ tier_alignment }}">
                    {%- if block.settings.threshold != blank -%}
                      <span class="subheading subheading-badge">{{ block.settings.threshold }}</span>
                    {%- endif -%}

                    {%- if block.settings.value != blank -%}
                      <p class="discount-tiers__value justify-{{ tier_alignment }}">
                        {%- if block.settings.value_label != blank -%}
                          <span class="{{ section.settings.value_label_size }}">{{ block.settings.value_label }}</span>
                        {%- endif -%}

                        <span class="discount-tiers__value-amount {{ section.settings.value_size }}">{{ block.settings.value }}</span>
                      </p>
                    {%- endif -%}

                    {%- if block.settings.caption != blank -%}
                      <p class="text-sm text-subdued">{{ block.settings.caption }}</p>
                    {%- endif -%}
                  </div>
                </div>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Text with discount tiers",
  "class": "shopify-section--text-with-discount-tiers",
  "tag": "section",
  "max_blocks": 5,
  "disabled_on": {
    "groups": ["header", "custom.overlay"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:global.text.content"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "t:global.position.position",
      "options": [
        {
          "value": "start",
          "label": "t:global.position.left"
        },
        {
          "value": "end",
          "label": "t:global.position.right"
        }
      ],
      "default": "start"
    },
    {
      "type": "range",
      "id": "content_percentage_width",
      "min": 40,
      "max": 60,
      "step": 5,
      "unit": "%",
      "label": "t:sections.text_with_media.content_percentage_width",
      "default": 50
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "t:global.text.subheading",
      "default": "Black Week"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "t:global.text.heading",
      "default": "Sådan fungerer det"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:global.text.heading_size",
      "options": [
        {
          "value": "display-xl",
          "label": "Display XL"
        },
        {
          "value": "display-l",
          "label": "Display L"
        },
        {
          "value": "display-m",
          "label": "Display M"
        },
        {
          "value": "h1",
          "label": "XX-Large"
        },
        {
          "value": "h2",
          "label": "X-Large"
        },
        {
          "value": "h3",
          "label": "Large"
        },
        {
          "value": "h4",
          "label": "Medium"
        },
        {
          "value": "h5",
          "label": "Small"
        },
        {
          "value": "h6",
          "label": "X-Small"
        },
        {
          "value": "h7",
          "label": "XX-Small"
        }
      ],
      "default": "display-m"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "t:global.text.content",
      "default": "<p>Explain how your tiered discount works, when it starts and how customers unlock each level.</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "t:global.text.button_text"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:global.text.button_link"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "t:global.text.button_style",
      "options": [
        {
          "value": "solid",
          "label": "t:global.text.button_style_options.solid"
        },
        {
          "value": "outline",
          "label": "t:global.text.button_style_options.outline"
        },
        {
          "value": "link",
          "label": "t:global.text.button_style_options.link"
        }
      ],
      "default": "solid",
      "visible_if": "{{ section.settings.button_text != blank }}"
    },
    {
      "type": "text_alignment",
      "id": "text_alignment",
      "label": "t:global.text.alignment",
      "default": "left"
    },
    {
      "type": "header",
      "content": "Tiers card"
    },
    {
      "type": "color_scheme",
      "id": "card_color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-2"
    },
    {
      "type": "checkbox",
      "id": "add_card_spacing",
      "label": "Add card spacing",
      "default": true
    },
    {
      "type": "select",
      "id": "card_size",
      "label": "t:global.sizes.size",
      "options": [
        {
          "value": "auto",
          "label": "t:global.sizes.original_image_ratio"
        },
        {
          "value": "xs",
          "label": "t:global.sizes.x_small"
        },
        {
          "value": "sm",
          "label": "t:global.sizes.small"
        },
        {
          "value": "md",
          "label": "t:global.sizes.medium"
        },
        {
          "value": "lg",
          "label": "t:global.sizes.large"
        }
      ],
      "default": "sm"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:global.image.image",
      "info": "Optional. 2000 x 1400px .jpg recommended."
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "t:global.image.mobile_image",
      "visible_if": "{{ section.settings.image != blank }}"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "t:global.colors.image_overlay_color",
      "default": "#000000",
      "visible_if": "{{ section.settings.image != blank }}"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "t:global.colors.image_overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 40,
      "visible_if": "{{ section.settings.image != blank }}"
    },
    {
      "type": "header",
      "content": "Tiers"
    },
    {
      "type": "range",
      "id": "tiers_per_row_desktop",
      "min": 1,
      "max": 5,
      "step": 1,
      "label": "Tiers per row (desktop)",
      "default": 3
    },
    {
      "type": "range",
      "id": "tiers_per_row_mobile",
      "min": 1,
      "max": 3,
      "step": 1,
      "label": "Tiers per row (mobile)",
      "default": 1
    },
    {
      "type": "checkbox",
      "id": "show_separators",
      "label": "Show separators",
      "default": true
    },
    {
      "type": "text_alignment",
      "id": "tier_text_alignment",
      "label": "t:global.text.alignment",
      "default": "center"
    },
    {
      "type": "select",
      "id": "value_size",
      "label": "Discount size",
      "options": [
        {
          "value": "display-xl",
          "label": "Display XL"
        },
        {
          "value": "display-l",
          "label": "Display L"
        },
        {
          "value": "display-m",
          "label": "Display M"
        },
        {
          "value": "h1",
          "label": "XX-Large"
        },
        {
          "value": "h2",
          "label": "X-Large"
        },
        {
          "value": "h3",
          "label": "Large"
        }
      ],
      "default": "display-m"
    },
    {
      "type": "select",
      "id": "value_label_size",
      "label": "Discount label size",
      "options": [
        {
          "value": "h4",
          "label": "Medium"
        },
        {
          "value": "h5",
          "label": "Small"
        },
        {
          "value": "h6",
          "label": "X-Small"
        },
        {
          "value": "h7",
          "label": "XX-Small"
        }
      ],
      "default": "h5"
    },
    {
      "type": "color",
      "id": "value_color",
      "label": "Discount color",
      "info": "Leave empty to use the card color scheme text color."
    }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Tier",
      "settings": [
        {
          "type": "text",
          "id": "threshold",
          "label": "Threshold",
          "default": "Over 500 kr."
        },
        {
          "type": "text",
          "id": "value_label",
          "label": "Discount label",
          "default": "Spar"
        },
        {
          "type": "text",
          "id": "value",
          "label": "Discount",
          "default": "10%"
        },
        {
          "type": "inline_richtext",
          "id": "caption",
          "label": "Caption"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Text with discount tiers",
      "blocks": [
        {
          "type": "tier",
          "settings": {
            "threshold": "Over 500 kr.",
            "value_label": "Spar",
            "value": "10%"
          }
        },
        {
          "type": "tier",
          "settings": {
            "threshold": "Over 1.500 kr.",
            "value_label": "Spar",
            "value": "15%"
          }
        },
        {
          "type": "tier",
          "settings": {
            "threshold": "Over 2.500 kr.",
            "value_label": "Spar",
            "value": "20%"
          }
        }
      ]
    }
  ]
}
{% endschema %}
