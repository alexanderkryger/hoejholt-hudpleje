var rDuration = root.querySelector('[data-r-duration]');
var rPrice    = root.querySelector('[data-r-price]');
var rCta      = root.querySelector('[data-r-cta]');
var barLabel  = root.querySelector('[data-bar-label]');
var barStep   = root.querySelector('[data-bar-step]');
var btnBack   = root.querySelector('[data-action="back"]');
var btnNext   = root.querySelector('[data-action="next"]');
var progress  = root.querySelector('[data-progress]');
var nameInput      = root.querySelector('[data-name-input]');
var genderBtns     = root.querySelectorAll('[data-gender]');
var profileNameDisp = root.querySelector('[data-profile-name-gender]');
var ageLabel  = root.querySelector('[data-age-label]');
var ageValue  = root.querySelector('[data-age-value]');
var ageMinus  = root.querySelector('[data-age-action="minus"]');
var agePlus   = root.querySelector('[data-age-action="plus"]');
var pregnantBtns    = root.querySelectorAll('[data-pregnant]');
var pregnantNameDisp = root.querySelector('[data-profile-name-pregnant]');
var loadBar   = root.querySelector('[data-load-bar]');
var loadLines = root.querySelectorAll('[data-load-line]');
var welcomeName = root.querySelector('[data-welcome-name]');

var step = -1;
var profile = { name: '', gender: '', age: 30, pregnant: '' };
var answers = {};
var winningKey = '';

function needsPregnancyStep() {
  return profile.gender === 'Kvinde' && profile.age >= 20 && profile.age <= 44;
}

function getTotalSteps() {
  return PROFILE_STEPS + QUIZ_STEPS + (needsPregnancyStep() ? 1 : 0);
}

function showScreen(key) {
  allScreens.forEach(function(s) {
    s.classList.toggle('fq__screen--active', s.getAttribute('data-screen') === key);
  });
}

function stepToScreen(s) {
  if (s < 0)  return 'intro';
  if (s === 0) return 'profile-name';
  if (s === 1) return 'profile-gender';
  if (s === 2) return 'profile-age';
  if (s === 3) return 'welcome';
  var quizEnd = PROFILE_STEPS + QUIZ_STEPS;
  if (s < quizEnd) return 'quiz';
  if (needsPregnancyStep() && s === quizEnd) return 'profile-pregnant';
  return 'loading';
}

function canProceed() {
  if (step < 0) return true;
  if (step === 0) return profile.name.trim().length > 0;
  if (step === 1) return profile.gender !== '';
  if (step === 2) return true;
  if (step === 3) return true;
  var quizEnd = PROFILE_STEPS + QUIZ_STEPS;
  if (step < quizEnd) {
    var qIdx = step - PROFILE_STEPS;
    return answers[quizQuestions[qIdx].id] !== undefined;
  }
  if (needsPregnancyStep() && step === quizEnd) {
    return profile.pregnant !== '';
  }
  return true;
}

function updateBar() {
  var total = getTotalSteps();
  var isProfile = step >= 0 && step < PROFILE_STEPS;
  var isWelcome = step === 3;
  barLabel.textContent = step < 0 ? 'Facialmatch' : isWelcome ? '' : isProfile ? 'Profiler' : 'Facialmatch';
  barStep.textContent  = step < 0 || isWelcome ? '' : 'Trin ' + (step + 1) + ' af ' + total;
  btnBack.disabled = (step <= -1 || isWelcome);
  btnNext.disabled = isWelcome ? true : !canProceed();
  progress.style.width = (step < 0 ? 0 : ((step + 1) / total * 100)) + '%';
}

function enterStep() {
  var screen = stepToScreen(step);
  showScreen(screen);

  if (step === 1) {
    profileNameDisp.textContent = profile.name || '';
    genderBtns.forEach(function(b) {
      b.classList.toggle('fq__option--selected', b.getAttribute('data-gender') === profile.gender);
    });
  }
  if (step === 2) {
    ageLabel.textContent = profile.name || '';
    ageValue.textContent = profile.age;
  }
  if (step === 3) {
    welcomeName.textContent = 'Velkommen ' + (profile.name || '');
    welcomeName.style.animation = 'none';
    root.querySelector('.fq__welcome-sub').style.animation = 'none';
    void welcomeName.offsetWidth;
    welcomeName.style.animation = '';
    root.querySelector('.fq__welcome-sub').style.animation = '';
    btnNext.disabled = true;
    btnBack.disabled = true;
    setTimeout(function() {
      if (step === 3) { step++; enterStep(); }
    }, 2800);
    return;
  }
  if (screen === 'quiz') {
    renderQuestion(step - PROFILE_STEPS);
  }
  if (screen === 'profile-pregnant') {
    pregnantNameDisp.textContent = profile.name || '';
    pregnantBtns.forEach(function(b) {
      b.classList.toggle('fq__option--selected', b.getAttribute('data-pregnant') === profile.pregnant);
    });
  }
  updateBar();
  if (step === 0) setTimeout(function() { nameInput.focus(); }, 100);
}

/* ---- Name ---- */
nameInput.addEventListener('input', function() { profile.name = nameInput.value; updateBar(); });
nameInput.addEventListener('keydown', function(e) { if (e.key === 'Enter' && canProceed()) goNext(); });

/* ---- Gender ---- */
genderBtns.forEach(function(btn) {
  btn.addEventListener('click', function() {
    profile.gender = btn.getAttribute('data-gender');
    genderBtns.forEach(function(b) { b.classList.toggle('fq__option--selected', b === btn); });
    if (profile.gender !== 'Kvinde') { profile.pregnant = ''; }
    updateGenderOrbs();
    btnNext.disabled = false;
  });
});

function updateGenderOrbs() {
  var cls = profile.gender === 'Kvinde' ? 'fq__orb--kvinde' : profile.gender === 'Mand' ? 'fq__orb--mand' : 'fq__orb--andet';
  root.querySelectorAll('[data-gender-orb]').forEach(function(orb) {
    orb.classList.remove('fq__orb--mand', 'fq__orb--kvinde', 'fq__orb--andet');
    orb.classList.add(cls);
  });
}

/* ---- Pregnancy ---- */
pregnantBtns.forEach(function(btn) {
  btn.addEventListener('click', function() {
    profile.pregnant = btn.getAttribute('data-pregnant');
    pregnantBtns.forEach(function(b) { b.classList.toggle('fq__option--selected', b === btn); });
    btnNext.disabled = false;
  });
});

/* ---- Age ---- */
function setAge(v) { profile.age = Math.max(12, Math.min(90, v)); ageValue.textContent = profile.age; }
var ageInterval = null, ageTimeout = null;
function startHold(d) {
  setAge(profile.age + d);
  ageTimeout = setTimeout(function() { ageInterval = setInterval(function() { setAge(profile.age + d); }, 80); }, 400);
}
function stopHold() { clearTimeout(ageTimeout); clearInterval(ageInterval); }
ageMinus.addEventListener('mousedown', function() { startHold(-1); });
ageMinus.addEventListener('touchstart', function(e) { e.preventDefault(); startHold(-1); });
agePlus.addEventListener('mousedown', function() { startHold(1); });
agePlus.addEventListener('touchstart', function(e) { e.preventDefault(); startHold(1); });
document.addEventListener('mouseup', stopHold);
document.addEventListener('touchend', stopHold);

/* ---- Quiz renderer ---- */
function renderQuestion(qIdx) {
  var q = quizQuestions[qIdx], sel = answers[q.id], html = '';

  if (q.info) {
    qTitle.innerHTML = q.question + '<button class="fq__info-toggle" data-info-toggle aria-label="Info">?</button>';
  } else {
    qTitle.textContent = q.question;
  }

  var infoHtml = '';
  if (q.info) {
    infoHtml = '<div class="fq__info-box" data-info-box>' + q.info + '</div>';
  }

  if (q.type === 'slider') {
    var cur = (sel !== undefined) ? sel : 0;
    var count = q.options.length;
    var pct = count > 1 ? (cur / (count - 1) * 100) : 0;

    html = infoHtml + '<div class="fq__slider fq__anim">';
    html += '<div class="fq__slider-value" data-slider-value>' + q.options[cur].label + '</div>';
    html += '<div class="fq__slider-middle">';
    if (profile.name) html += '<div class="fq__slider-name">' + profile.name + '</div>';
    html += '</div>';
    html += '<div class="fq__slider-track-wrap" data-slider-wrap>';
    html += '<div class="fq__slider-track">';
    html += '<div class="fq__slider-track-fill" style="width:' + pct + '%"></div>';
    q.options.forEach(function(opt, i) {
      var sp = count > 1 ? (i / (count - 1) * 100) : 50;
      var passed = i <= cur ? ' fq__slider-snap--passed' : '';
      html += '<div class="fq__slider-snap' + passed + '" style="left:' + sp + '%"></div>';
    });
    html += '<div class="fq__slider-thumb' + (profile.gender === 'Kvinde' ? ' fq__slider-thumb--kvinde' : profile.gender === 'Andet' ? ' fq__slider-thumb--andet' : '') + '" data-slider-thumb style="left:' + pct + '%"></div>';
    html += '</div></div>';
    html += '<div class="fq__slider-labels">';
    html += '<span class="fq__slider-label-edge">' + q.options[0].label + '</span>';
    html += '<span class="fq__slider-label-edge">' + q.options[count - 1].label + '</span>';
    html += '</div>';
    html += '</div>';

    qBody.innerHTML = html;

    var wrap = qBody.querySelector('[data-slider-wrap]');
    var thumb = qBody.querySelector('[data-slider-thumb]');
    var fill = qBody.querySelector('.fq__slider-track-fill');
    var valueEl = qBody.querySelector('[data-slider-value]');
    var snaps = qBody.querySelectorAll('.fq__slider-snap');
    var sliderIdx = cur;
    var dragging = false;

    function snapTo(idx, animate) {
      if (idx < 0) idx = 0;
      if (idx >= count) idx = count - 1;
      if (idx === sliderIdx && animate) return;
      var oldIdx = sliderIdx;
      sliderIdx = idx;
      var p = count > 1 ? (idx / (count - 1) * 100) : 0;
      thumb.style.left = p + '%';
      fill.style.width = p + '%';
      snaps.forEach(function(s, si) { s.classList.toggle('fq__slider-snap--passed', si <= idx); });
      if (oldIdx !== idx) {
        valueEl.classList.add('fq__slider-value--exit');
        setTimeout(function() {
          valueEl.textContent = q.options[idx].label;
          valueEl.classList.remove('fq__slider-value--exit');
        }, 120);
      }
      answers[q.id] = idx;
      btnNext.disabled = false;
    }

    function getIdxFromX(clientX) {
      var rect = wrap.getBoundingClientRect();
      var ratio = Math.max(0, Math.min(1, (clientX - rect.left) / rect.width));
      return Math.round(ratio * (count - 1));
    }

    function onStart(e) {
      dragging = true;
      wrap.classList.add('fq__slider-track-wrap--dragging');
      var x = e.touches ? e.touches[0].clientX : e.clientX;
      snapTo(getIdxFromX(x), false);
    }
    function onMove(e) {
      if (!dragging) return;
      e.preventDefault();
      var x = e.touches ? e.touches[0].clientX : e.clientX;
      var rect = wrap.getBoundingClientRect();
      var ratio = Math.max(0, Math.min(1, (x - rect.left) / rect.width));
      var p = ratio * 100;
      thumb.style.left = p + '%';
      fill.style.width = p + '%';
      var nearIdx = Math.round(ratio * (count - 1));
      snaps.forEach(function(s, si) { s.classList.toggle('fq__slider-snap--passed', si <= nearIdx); });
      if (nearIdx !== sliderIdx) {
        sliderIdx = nearIdx;
        valueEl.classList.add('fq__slider-value--exit');
        setTimeout(function() {
          valueEl.textContent = q.options[nearIdx].label;
          valueEl.classList.remove('fq__slider-value--exit');
        }, 80);
        answers[q.id] = nearIdx;
      }
    }
    function onEnd() {
      if (!dragging) return;
      dragging = false;
      wrap.classList.remove('fq__slider-track-wrap--dragging');
      snapTo(sliderIdx, true);
    }

    thumb.addEventListener('mousedown', function(e) { e.preventDefault(); onStart(e); });
    thumb.addEventListener('touchstart', function(e) { onStart(e); }, { passive: true });
    wrap.addEventListener('click', function(e) { if (!dragging) snapTo(getIdxFromX(e.clientX), true); });
    document.addEventListener('mousemove', onMove);
    document.addEventListener('touchmove', onMove, { passive: false });
    document.addEventListener('mouseup', onEnd);
    document.addEventListener('touchend', onEnd);

    if (sel === undefined) { answers[q.id] = 0; btnNext.disabled = false; }

  } else if (q.type === 'cards') {
    html = infoHtml;
    html += '<div class="fq__cards fq__anim">';
    q.options.forEach(function(opt, i) {
      var sc = i === sel ? ' fq__card--selected' : '';
      html += '<div class="fq__card' + sc + '" data-idx="' + i + '" role="button" tabindex="0">';
      html += '<span class="fq__card-label">' + opt.label + '</span>';
      if (opt.sub) html += '<span class="fq__card-sub">' + opt.sub + '</span>';
      html += '</div>';
    });
    html += '</div>';
    qBody.innerHTML = html;
    var items = qBody.querySelectorAll('[data-idx]');
    items.forEach(function(item) {
      function doSelect() {
        var idx = parseInt(item.getAttribute('data-idx'), 10);
        answers[q.id] = idx;
        items.forEach(function(el, j) { el.classList.toggle('fq__card--selected', j === idx); });
        btnNext.disabled = false;
      }
      item.addEventListener('click', doSelect);
      item.addEventListener('keydown', function(e) { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); doSelect(); } });
    });
  } else {
    html = infoHtml;
    html += '<div class="fq__options fq__anim">';
    q.options.forEach(function(opt, i) {
      var sc = i === sel ? ' fq__option--selected' : '';
      html += '<button class="fq__option' + sc + '" data-idx="' + i + '">' + opt.label + '</button>';
    });
    html += '</div>';
    qBody.innerHTML = html;
    var items = qBody.querySelectorAll('[data-idx]');
    items.forEach(function(item) {
      function doSelect() {
        var idx = parseInt(item.getAttribute('data-idx'), 10);
        answers[q.id] = idx;
        items.forEach(function(el, j) { el.classList.toggle('fq__option--selected', j === idx); });
        btnNext.disabled = false;
      }
      item.addEventListener('click', doSelect);
      item.addEventListener('keydown', function(e) { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); doSelect(); } });
    });
  }

  var infoToggle = qTitle.querySelector('[data-info-toggle]');
  var infoBox = qBody.querySelector('[data-info-box]');
  if (infoToggle && infoBox) {
    infoToggle.addEventListener('click', function(e) {
      e.stopPropagation();
      infoBox.classList.toggle('fq__info-box--open');
      infoToggle.textContent = infoBox.classList.contains('fq__info-box--open') ? '×' : '?';
    });
  }
}

/* ---- Scoring ---- */
function calcResult() {
  var scores = {};
  var age = profile.age;
  var isTeenager = age >= 12 && age <= 20;

  Object.keys(treatments).forEach(function(k) {
    if (k === 'teenager' && !isTeenager) return;
    if (k === 'gravid' && profile.pregnant !== 'yes' && profile.pregnant !== 'recent') return;
    scores[k] = 0;
  });

  quizQuestions.forEach(function(q) {
    var idx = answers[q.id];
    if (idx !== undefined && q.options[idx]) {
      var s = q.options[idx].scores;
      Object.keys(s).forEach(function(k) {
        if (scores[k] !== undefined) scores[k] += s[k];
      });
    }
  });

  /* Age-based bonus: teenager +20 for age 12–20 */
  if (isTeenager && scores.teenager !== undefined) {
    scores.teenager += 20;
  }

  /* Pregnancy bonus */
  if (profile.pregnant === 'yes') {
    if (scores.gravid !== undefined) scores.gravid += 12;
  } else if (profile.pregnant === 'recent') {
    if (scores.gravid !== undefined) scores.gravid += 8;
    if (scores.drjoseph_signatur !== undefined) scores.drjoseph_signatur += 6;
    if (scores.phformula !== undefined) scores.phformula += 2;
  }

  var best = null, max = -1;
  Object.keys(scores).forEach(function(k) {
    if (scores[k] > max) { max = scores[k]; best = k; }
  });
  return best;
}

/* ---- Loading animation ---- */
function playLoading(callback) {
  showScreen('loading');
  barLabel.textContent = 'Facialmatch';
  barStep.textContent = '';
  progress.style.width = '100%';
  btnNext.disabled = true;
  btnBack.disabled = true;

  var bar = loadBar;
  var lines = loadLines;
  var lineCount = lines.length;
  var duration = 3200;
  var perLine = duration / lineCount;

  bar.style.transition = 'none';
  bar.style.width = '0%';
  lines.forEach(function(l) { l.classList.remove('fq__loading-line--active'); });

  setTimeout(function() {
    bar.style.transition = 'width ' + (duration / 1000) + 's ease';
    bar.style.width = '100%';
  }, 50);

  for (var i = 0; i < lineCount; i++) {
    (function(idx) {
      setTimeout(function() {
        lines.forEach(function(l) { l.classList.remove('fq__loading-line--active'); });
        lines[idx].classList.add('fq__loading-line--active');
      }, idx * perLine);
    })(i);
  }

  setTimeout(callback, duration + 200);
}

/* ---- Show result ---- */
function showResult() {
  winningKey = calcResult();
  var t = treatments[winningKey];
  rGreeting.textContent = profile.name ? ('Hej ' + profile.name + ', vi anbefaler') : 'Vi anbefaler';
  rName.textContent = t.name;
  rDesc.textContent = t.desc;
  rDuration.textContent = t.duration;
  rPrice.textContent = t.price;
  rCta.href = t.ctaUrl;
  showScreen('result');
  barLabel.textContent = 'Resultat';
  barStep.textContent = '';
  progress.style.width = '100%';
  btnNext.disabled = true;
  btnBack.disabled = false;
  root.scrollIntoView({ behavior: 'smooth', block: 'start' });

  /* Meta Pixel — quiz completed */
  if (typeof fbq === 'function') {
    fbq('track', 'CompleteRegistration', {
      content_name: t.name,
      content_category: 'Facialmatch',
      value: 0,
      currency: 'DKK'
    });
  }

  setTimeout(function() {
    if (!mcOverlay.classList.contains('fq__modal-overlay--open')) {
      openSaveModal();
    }
  }, 5000);
}

/* ---- Navigation ---- */
function isLastStep() {
  var total = getTotalSteps();
  return step >= total - 1;
}

function goNext() {
  if (!canProceed()) return;
  if (isLastStep()) {
    playLoading(showResult);
  } else {
    step++;
    enterStep();
  }
}
function goBack() {
  if (step > 0) {
    step--;
    if (step === 3) step--; /* skip welcome screen */
    enterStep();
  }
  else if (step === 0) { step = -1; showScreen('intro'); updateBar(); }
}
function retake() {
  step = -1; profile = { name: '', gender: '', age: 30, pregnant: '' }; answers = {};
  nameInput.value = '';
  genderBtns.forEach(function(b) { b.classList.remove('fq__option--selected'); });
  pregnantBtns.forEach(function(b) { b.classList.remove('fq__option--selected'); });
  root.querySelectorAll('[data-gender-orb]').forEach(function(orb) {
    orb.classList.remove('fq__orb--kvinde', 'fq__orb--andet');
    orb.classList.add('fq__orb--mand');
  });
  showScreen('intro'); updateBar();
  root.scrollIntoView({ behavior: 'smooth', block: 'start' });
}

btnNext.addEventListener('click', goNext);
btnBack.addEventListener('click', goBack);
root.querySelector('[data-action="retake"]').addEventListener('click', retake);
root.querySelector('[data-action="start"]').addEventListener('click', goNext);
updateBar();

/* ==============================================================
   GEM RESULTAT — MAILCHIMP POPUP
   ---------------------------------------------------------------
   Posts to Mailchimp via JSONP (no page redirect).
   Sends: EMAIL, FNAME, FACEMATCH (treatment name), tag 6678956.
   ============================================================== */

var mcOverlay  = root.querySelector('[data-save-overlay]');
var mcBody     = root.querySelector('[data-save-body]');
var mcFname    = root.querySelector('[data-mc-fname]');
var mcEmail    = root.querySelector('[data-mc-email]');
var mcMatch    = root.querySelector('[data-mc-facematch]');
var mcSubmit   = root.querySelector('[data-action="save-submit"]');
var mcSuccess  = root.querySelector('[data-save-success]');
var mcError    = root.querySelector('[data-save-error]');

var MC_URL = 'https://hoejholthudpleje.us13.list-manage.com/subscribe/post?u=1a0a0f500dc6fc987c19f8621&id=8ba4e54520&f_id=0066e0e2f0';

function openSaveModal() {
  mcFname.value = profile.name || '';
  mcEmail.value = '';
  mcSubmit.disabled = true;
  mcSubmit.textContent = 'Gem mit Resultat';
  mcBody.style.display = '';
  mcSuccess.classList.remove('fq__modal-success--visible');
  mcError.classList.remove('fq__modal-error--visible');
  updateGenderOrbs();
  mcOverlay.classList.add('fq__modal-overlay--open');
  setTimeout(function() { mcEmail.focus(); }, 350);
}

function closeSaveModal() {
  mcOverlay.classList.remove('fq__modal-overlay--open');
}

function validateMcForm() {
  var nameOk = mcFname.value.trim().length > 0;
  var emailOk = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(mcEmail.value.trim());
  mcSubmit.disabled = !(nameOk && emailOk);
}

function submitToMailchimp() {
  if (mcSubmit.disabled) return;
  mcSubmit.disabled = true;
  mcSubmit.textContent = 'Sender...';

  var treatmentName = treatments[winningKey] ? treatments[winningKey].name : '';

  var formData = new FormData();
  formData.append('EMAIL', mcEmail.value.trim());
  formData.append('FNAME', mcFname.value.trim());
  formData.append('FACEMATCH', treatmentName);
  formData.append('MERGE8', treatmentName);
  formData.append('tags', '6678956');
  formData.append('b_1a0a0f500dc6fc987c19f8621_8ba4e54520', '');

  fetch(MC_URL, {
    method: 'POST',
    body: formData,
    mode: 'no-cors'
  }).then(function() {
    mcBody.style.display = 'none';
    mcSuccess.classList.add('fq__modal-success--visible');
  }).catch(function() {
    mcBody.style.display = 'none';
    mcSuccess.classList.add('fq__modal-success--visible');
  });
}

root.querySelector('[data-action="save-open"]').addEventListener('click', openSaveModal);
root.querySelector('[data-action="save-close"]').addEventListener('click', closeSaveModal);
mcOverlay.addEventListener('click', function(e) { if (e.target === mcOverlay) closeSaveModal(); });
mcFname.addEventListener('input', validateMcForm);
mcEmail.addEventListener('input', validateMcForm);
mcSubmit.addEventListener('click', submitToMailchimp);
mcEmail.addEventListener('keydown', function(e) { if (e.key === 'Enter') { e.preventDefault(); submitToMailchimp(); } });
})();
</script>

