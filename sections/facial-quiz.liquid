/* ==============================================================
   ENGINE
   ---------------------------------------------------------------
   Flow: intro → name → gender → age → quiz questions →
         [pregnancy if Kvinde] → loading animation → result
   ============================================================== */

var PROFILE_STEPS = 4;
var QUIZ_STEPS = quizQuestions.length;

var root = document.getElementById('fq');
if (!root) return;

var allScreens = root.querySelectorAll('.fq__screen');
var qTitle    = root.querySelector('[data-q-title]');
var qBody     = root.querySelector('[data-q-body]');
var rGreeting = root.querySelector('[data-r-greeting]');
var rName     = root.querySelector('[data-r-name]');
