{%- comment -%}
  Section: Category Slider
  Compatible with Maestrooo Stretch theme (Online Store 2.0)
  Horizontal slider with Product and Text blocks, optional vertical linear text.
  No external libraries — native CSS scroll-snap + lightweight JS.
{%- endcomment -%}

{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.background_color
  assign container_width = section.settings.container_width
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
  assign gap = section.settings.gap
  assign linear_enabled = section.settings.linear_text_enabled
  assign linear_text = section.settings.linear_text_content
  assign linear_subtext = section.settings.linear_subtext
  assign linear_position = section.settings.linear_text_position
  assign linear_color = section.settings.linear_text_color
  assign linear_opacity = section.settings.linear_text_opacity
  assign linear_offset = section.settings.linear_text_offset
  assign has_linear = false
  if linear_enabled and linear_text != blank
    assign has_linear = true
  endif
  assign inner_bg = section.settings.inner_background_color
  assign inner_padding = section.settings.inner_padding
  assign inner_radius = section.settings.inner_border_radius
  assign inner_margin_left = section.settings.inner_margin_left
-%}

<style>
  /* ===== Section Shell ===== */
  .cs-section-{{ section_id }} {
    --cs-bg: {{ bg_color }};
    --cs-gap: {{ gap }}px;
    --cs-pt: {{ padding_top }}px;
    --cs-pb: {{ padding_bottom }}px;
    --cs-linear-color: {{ linear_color }};
    --cs-linear-opacity: {{ linear_opacity | divided_by: 100.0 }};
    --cs-linear-offset: {{ linear_offset }}px;
    --cs-inner-bg: {{ inner_bg | default: 'transparent' }};
    --cs-inner-padding: {{ inner_padding }}px;
    --cs-inner-radius: {{ inner_radius }}px;
    --cs-inner-ml: {{ inner_margin_left }}px;

    position: relative;
    background-color: var(--cs-bg);
    padding-top: var(--cs-pt);
    padding-bottom: var(--cs-pb);
    overflow: hidden;
  }

  /* ===== Container ===== */
  .cs-container-{{ section_id }} {
    position: relative;
    margin: 0 auto;
  }

  .cs-container-{{ section_id }}.cs-container--page-width {
    max-width: var(--page-width, 1200px);
    padding-left: var(--page-gutter, 20px);
    padding-right: var(--page-gutter, 20px);
  }

  .cs-container-{{ section_id }}.cs-container--full-width {
    max-width: 100%;
    padding-left: 0;
    padding-right: 0;
  }

  /* ===== Slider Layout ===== */
  .cs-slider-layout-{{ section_id }} {
    position: relative;
    background-color: var(--cs-inner-bg);
    padding: var(--cs-inner-padding) var(--cs-inner-padding) var(--cs-inner-padding) 0;
    border-radius: var(--cs-inner-radius) 0 0 var(--cs-inner-radius);
    margin-left: var(--cs-inner-ml);
    overflow: hidden;
  }

  /* ===== Linear / Side Text =====
     Absolutely positioned BEHIND the cards — slides scroll over it. */
  .cs-linear-{{ section_id }} {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    z-index: 1;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-left: calc(var(--cs-linear-offset) + 8px);
    padding-right: 12px;
    padding-top: calc(var(--cs-inner-padding) + 4px);
    pointer-events: none;
    will-change: transform, opacity;
    transition: transform 0.05s linear, opacity 0.05s linear;
  }

  .cs-linear-{{ section_id }}.cs-linear--right {
    left: auto;
    right: 0;
    padding-left: 12px;
    padding-right: calc(var(--cs-linear-offset) + 8px);
  }

  .cs-linear__inner {
    writing-mode: vertical-rl;
    text-orientation: mixed;
    transform: rotate(180deg);
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 12px;
    color: var(--cs-linear-color);
    opacity: var(--cs-linear-opacity);
    white-space: nowrap;
    text-align: right;
  }

  .cs-linear__text {
    font-size: clamp(1.8rem, 2vw, 3rem);
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    line-height: 1;
  }

  .cs-linear__subtext {
    font-size: clamp(0.65rem, 1vw, 0.8rem);
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.7;
  }

  /* ===== Track Area ===== */
  .cs-track-area-{{ section_id }} {
    position: relative;
    z-index: 2;
    min-width: 0;
  }

  .cs-track-wrapper-{{ section_id }} {
    position: relative;
  }

  .cs-track-{{ section_id }} {
    display: flex;
    gap: var(--cs-gap);
    overflow-x: auto;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding: 4px 4px 4px var(--cs-linear-width, 0px);
  }

  .cs-track-{{ section_id }}::-webkit-scrollbar {
    display: none;
  }

  .cs-track-{{ section_id }}.cs-track--grabbing {
    cursor: grabbing;
    scroll-behavior: auto;
    user-select: none;
  }

  .cs-track-{{ section_id }}:not(.cs-track--grabbing) {
    cursor: grab;
  }

  /* Track edge padding — right side gets page gutter. Left side uses
     linear width (set by JS) so cards start after the linear text. */
  .cs-container--full-width .cs-track-{{ section_id }} {
    padding-right: var(--page-gutter, 20px);
  }

  /* ===== Slide (shared) ===== */
  .cs-section-{{ section_id }} .cs-slide {
    flex: 0 0 auto;
    width: clamp(280px, 38vw, 440px);
  }

  /* Square slides are 1.25× wider so the 1:1 card matches the height of 4:5 cards */
  .cs-section-{{ section_id }} .cs-slide--square {
    width: clamp(350px, 47.5vw, 550px);
  }

  /* ===== Card — unified base for both product & text blocks ===== */
  .cs-card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    aspect-ratio: 4 / 5;
    border-radius: 12px;
    overflow: hidden;
    text-decoration: none;
    color: #fff;
    background: rgba(0, 0, 0, 0.05);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .cs-card--square {
    aspect-ratio: 1 / 1;
  }


  a.cs-card:focus-visible,
  .cs-card:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
    border-radius: 14px;
  }

  /* ── Full-bleed background image ── */
  .cs-card__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .cs-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
    -webkit-user-drag: none;
    user-select: none;
    pointer-events: none;
  }

  a.cs-card:hover .cs-card__media img {
    transform: scale(1.03);
  }

  /* ── Gradient overlay for bottom text readability ── */
  .cs-card__gradient {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.55) 0%,
      rgba(0, 0, 0, 0.25) 35%,
      rgba(0, 0, 0, 0) 60%
    );
    pointer-events: none;
  }

  /* ── Custom overlay ── */
  .cs-card__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }

  /* ── Badge / Label pill — always top-left corner ── */
  .cs-card__badge {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 3;
    display: inline-block;
    background: #A38274;
    color: #F9EFE6;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    padding: 7px 12px;
    border-radius: 50px;
    line-height: 1.2;
    white-space: nowrap;
  }

  /* ── Content overlay at bottom of card ── */
  .cs-card__content {
    position: relative;
    z-index: 2;
    padding: 24px 20px;
  }

  .cs-card__content--center {
    text-align: center;
  }

  .cs-card__heading {
    font-size: clamp(1.1rem, 2.2vw, 1.5rem);
    font-weight: 600;
    line-height: 1.25;
    margin: 0 0 6px;
    color: #fff;
  }

    .cs-card__price {
    font-size: clamp(0.9rem, 1.4vw, 1.05rem);
    font-weight: 600;
    color: #fff;
    margin: 0 0 6px;
    line-height: 1.3;
  }

  .cs-card__price--compare {
    opacity: 0.6;
    font-weight: 400;
    margin-right: 6px;
    text-decoration: line-through;
  }

  .cs-card__text {
    font-size: clamp(0.85rem, 1.2vw, 0.95rem);
    line-height: 1.5;
    opacity: 0.88;
    margin: 0;
    color: #fff;
  }

  .cs-card__text p {
    margin: 0;
  }

  /* ── CTA Button (product cards) ── */
  .cs-card__cta {
    position: absolute;
    bottom: 16px;
    right: 16px;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    gap: 0;
    height: 48px;
    width: 48px;
    padding: 0;
    border: none;
    border-radius: 50px;
    background: #A38274;
    color: #F9EFE6;
    cursor: pointer;
    overflow: hidden;
    white-space: nowrap;
    transition: width 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94),
                padding 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94),
                gap 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .cs-card__cta-label {
    max-width: 0;
    opacity: 0;
    overflow: hidden;
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    transition: max-width 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94),
                opacity 0.25s ease 0.05s;
  }

  .cs-card__cta-icon {
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .cs-card__cta-icon svg {
    width: 20px;
    height: 20px;
  }

  /* Hover: expand to pill */
  .cs-card:hover .cs-card__cta,
  .cs-card:focus-within .cs-card__cta {
    width: auto;
    padding-left: 20px;
    gap: 2px;
  }

  .cs-card:hover .cs-card__cta-label,
  .cs-card:focus-within .cs-card__cta-label {
    max-width: 160px;
    opacity: 1;
  }

  /* ── Placeholder (no image) ── */
  .cs-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.06);
    width: 100%;
    height: 100%;
  }

  .cs-placeholder svg {
    width: 48px;
    height: 48px;
    opacity: 0.25;
  }

  /* ===== Navigation Arrows ===== */
  .cs-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.25);
    background: rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 5;
    transition: background 0.2s ease, border-color 0.2s ease, opacity 0.2s ease;
    opacity: 0;
    pointer-events: none;
  }

  .cs-track-wrapper-{{ section_id }}:hover .cs-nav,
  .cs-nav:focus-visible {
    opacity: 1;
    pointer-events: auto;
  }

  .cs-nav:hover {
    background: rgba(255, 255, 255, 0.22);
    border-color: rgba(255, 255, 255, 0.4);
  }

  .cs-nav:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }

  .cs-nav[disabled] {
    opacity: 0.25 !important;
    cursor: default;
    pointer-events: none;
  }

  .cs-nav svg {
    width: 20px;
    height: 20px;
  }

  .cs-nav--prev { left: 12px; }
  .cs-nav--next { right: 12px; }

  /* ===== Progress Bar =====
     Inside the track-area so it starts aligned with the first block. */
  .cs-progress-{{ section_id }} {
    width: 100%;
    height: 2px;
    background: rgba(255, 255, 255, 0.15);
    margin-top: 28px;
    overflow: hidden;
    margin-left:20px;
  }

  .cs-progress__bar {
    height: 100%;
    background: rgba(255, 255, 255, 0.55);
    width: 0%;
    transition: width 0.15s ease;
  }

  /* ===== Reduced Motion ===== */
  @media (prefers-reduced-motion: reduce) {
    .cs-track-{{ section_id }} { scroll-behavior: auto; }
    .cs-card,
    .cs-card__media img,
    .cs-card__cta,
    .cs-card__cta-label { transition: none; }
  }

  /* ===== Responsive ===== */
  @media (max-width: 749px) {
    .cs-slider-layout-{{ section_id }} {
      margin-left: 10px;
    }

    .cs-section-{{ section_id }} .cs-slide {
      width: clamp(240px, 72vw, 320px);
    }

    .cs-section-{{ section_id }} .cs-slide--square {
      width: clamp(300px, 90vw, 400px);
    }

    .cs-linear-{{ section_id }} {
      padding-left: calc(var(--cs-linear-offset) * 0.5 + 4px);
      padding-right: 6px;
    }

    .cs-linear__text {
      font-size: 1.4rem;
    }

    .cs-linear__subtext {
      font-size: 0.55rem;
    }

    .cs-nav {
      display: none;
    }
  }
</style>

{%- comment -%} ━━━━━━━━━━━━━━━━━━ HTML ━━━━━━━━━━━━━━━━━━ {%- endcomment -%}
<section
  class="cs-section-{{ section_id }}"
  data-section-id="{{ section_id }}"
  data-section-type="category-slider"
  aria-label="{{ section.settings.aria_label | default: 'Category slider' }}"
>
  <div class="cs-container-{{ section_id }} cs-container--{{ container_width }}">

    <div class="cs-slider-layout-{{ section_id }}">

      {%- comment -%} ── LINEAR / SIDE TEXT (absolute, behind cards) ── {%- endcomment -%}
      {%- if has_linear -%}
        <div class="cs-linear-{{ section_id }}{% if linear_position == 'right' %} cs-linear--right{% endif %}" aria-hidden="true" data-cs-linear>
          <div class="cs-linear__inner">
            <span class="cs-linear__text">{{ linear_text }}</span>
            {%- if linear_subtext != blank -%}
              <span class="cs-linear__subtext">{{ linear_subtext }}</span>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}

      {%- comment -%} ── TRACK AREA ── {%- endcomment -%}
      <div class="cs-track-area-{{ section_id }}">
        <div class="cs-track-wrapper-{{ section_id }}">

          <button
            class="cs-nav cs-nav--prev"
            aria-label="{{ 'general.slider.previous' | t | default: 'Previous slide' }}"
            data-cs-prev
            disabled
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
            </svg>
          </button>

          <button
            class="cs-nav cs-nav--next"
            aria-label="{{ 'general.slider.next' | t | default: 'Next slide' }}"
            data-cs-next
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
            </svg>
          </button>

          {%- comment -%} ── SLIDE TRACK ── {%- endcomment -%}
          <div class="cs-track-{{ section_id }}" data-cs-track role="list" tabindex="0">

            {%- for block in section.blocks -%}
              {%- case block.type -%}

                {%- comment -%} ━━━ PRODUCT BLOCK ━━━
                     No title/price from product — uses custom heading + text overlaid on image.
                {%- endcomment -%}
                {%- when 'product' -%}
                  {%- assign product = block.settings.product -%}
                  {%- assign badge = block.settings.badge_label -%}
                  {%- assign p_heading = block.settings.heading -%}
                  {%- assign p_text = block.settings.text -%}
                  {%- assign p_alignment = block.settings.text_alignment -%}
                  {%- assign p_overlay_color = block.settings.overlay_color -%}
                  {%- assign p_overlay_opacity = block.settings.overlay_opacity | divided_by: 100.0 -%}
                  {%- assign p_square = block.settings.square_format -%}

                  <div class="cs-slide{% if p_square %} cs-slide--square{% endif %}" role="listitem" {{ block.shopify_attributes }}>
                    {%- if product != blank -%}
                      <a href="{{ product.url }}" class="cs-card{% if p_square %} cs-card--square{% endif %}" aria-label="{{ p_heading | default: product.title }}">

                        <div class="cs-card__media">
                          {%- if product.featured_image != blank -%}
                            <img
                              src="{{ product.featured_image | image_url: width: 800 }}"
                              alt="{{ product.featured_image.alt | escape | default: product.title | escape }}"
                              width="{{ product.featured_image.width }}"
                              height="{{ product.featured_image.height }}"
                              loading="lazy"
                            >
                          {%- else -%}
                            <div class="cs-placeholder">
                              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.41a2.25 2.25 0 013.182 0l2.909 2.91m-18 3.75h16.5a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5 1.5 0 002.25 6v12a1.5 1.5 0 001.5 1.5z"/>
                              </svg>
                            </div>
                          {%- endif -%}
                        </div>

                        <div class="cs-card__overlay" style="background: {{ p_overlay_color }}; opacity: {{ p_overlay_opacity }};"></div>
                        <div class="cs-card__gradient"></div>

                        {%- if badge != blank -%}
                          <span class="cs-card__badge">{{ badge }}</span>
                        {%- endif -%}

                       <div class="cs-card__content{% if p_alignment == 'center' %} cs-card__content--center{% endif %}">
                          {%- if p_heading != blank -%}
                            <h3 class="cs-card__heading">{{ p_heading }}</h3>
                          {%- endif -%}
                          {%- if product != blank -%}
                            <p class="cs-card__price">
                                {%- if product.compare_at_price > product.price -%}
                                <s class="cs-card__price--compare">{{ product.compare_at_price | money_without_trailing_zeros }}</s>
                              {%- endif -%}
                                {{ product.price | money_without_trailing_zeros }}.
                            </p>
                          {%- endif -%}
                          {%- if p_text != blank -%}
                            <div class="cs-card__text">{{ p_text }}</div>
                          {%- endif -%}
                        </div>

                        {%- assign cta_label = block.settings.cta_label -%}
                        <span class="cs-card__cta" aria-hidden="true">
                          {%- if cta_label != blank -%}
                            <span class="cs-card__cta-label">{{ cta_label }}</span>
                          {%- endif -%}
                          <span class="cs-card__cta-icon">
                             <svg aria-hidden="true" focusable="false" width="{{ mobile_width | default: 24 }}" class="{{ class | strip }}" {% if style != blank %}style="{{ style }}"{% endif %} viewBox="0 0 24 24">
        <path vector-effect="non-scaling-stroke" d="M15.5001 3L13.6226 7.12304L9.5 9.00018L13.6226 10.877L15.5001 15L17.3773 10.877L21.5 9.00018L17.3773 7.12304L15.5001 3Z" fill="none" stroke="currentColor" stroke-width="{{ stroke_width | default: settings.icon_stroke_width }}"/>
        <path vector-effect="non-scaling-stroke" d="M4.50004 3L4.03066 4.03076L3 4.50005L4.03066 4.96924L4.50004 6L4.96933 4.96924L6 4.50005L4.96933 4.03076L4.50004 3Z" fill="none" stroke="currentColor" stroke-width="{{ stroke_width | default: settings.icon_stroke_width }}"/>
        <path vector-effect="non-scaling-stroke" d="M6.5001 13.5L5 16L2.5 17.5001L5 19L6.5001 21.5L8 19L10.5 17.5001L8 16L6.5001 13.5Z" fill="none" stroke="currentColor" stroke-width="{{ stroke_width | default: settings.icon_stroke_width }}"/>
      </svg>
                          </span>
                        </span>
                      </a>

                    {%- else -%}
                      <div class="cs-card{% if p_square %} cs-card--square{% endif %}">
                        <div class="cs-card__media">
                          <div class="cs-placeholder">
                            {{ 'product-1' | placeholder_svg_tag }}
                          </div>
                        </div>
                        <div class="cs-card__gradient"></div>
                        {%- if badge != blank -%}
                          <span class="cs-card__badge">{{ badge }}</span>
                        {%- endif -%}
                        <div class="cs-card__content">
                          <h3 class="cs-card__heading">{{ p_heading | default: 'Heading' }}</h3>
                          {%- if p_text != blank -%}
                            <div class="cs-card__text">{{ p_text }}</div>
                          {%- endif -%}
                        </div>
                      </div>
                    {%- endif -%}
                  </div>

                {%- comment -%} ━━━ TEXT BLOCK ━━━ {%- endcomment -%}
                {%- when 'text' -%}
                  {%- assign overlay_color = block.settings.overlay_color -%}
                  {%- assign overlay_opacity = block.settings.overlay_opacity | divided_by: 100.0 -%}
                  {%- assign alignment = block.settings.text_alignment -%}
                  {%- assign t_bg_color = block.settings.background_color -%}

                  <div class="cs-slide" role="listitem" {{ block.shopify_attributes }}>
                    <div class="cs-card"{% if block.settings.background_image == blank %} style="background: {{ t_bg_color }};"{% endif %}>

                      <div class="cs-card__media">
                        {%- if block.settings.background_image != blank -%}
                          <img
                            src="{{ block.settings.background_image | image_url: width: 800 }}"
                            alt=""
                            loading="lazy"
                            width="{{ block.settings.background_image.width }}"
                            height="{{ block.settings.background_image.height }}"
                          >
                        {%- endif -%}
                      </div>

                      <div class="cs-card__overlay" style="background: {{ overlay_color }}; opacity: {{ overlay_opacity }};"></div>
                      {%- if block.settings.background_image != blank -%}
                        <div class="cs-card__gradient"></div>
                      {%- endif -%}

                      {%- if block.settings.label != blank -%}
                        <span class="cs-card__badge">{{ block.settings.label }}</span>
                      {%- endif -%}

                      <div class="cs-card__content{% if alignment == 'center' %} cs-card__content--center{% endif %}">
                        {%- if block.settings.heading != blank -%}
                          <h3 class="cs-card__heading">{{ block.settings.heading }}</h3>
                        {%- endif -%}
                        {%- if block.settings.text != blank -%}
                          <div class="cs-card__text">{{ block.settings.text }}</div>
                        {%- endif -%}
                      </div>

                    </div>
                  </div>

              {%- endcase -%}
            {%- endfor -%}

          </div>
        </div>

        {%- comment -%} Progress bar — inside track-area, aligned with first block {%- endcomment -%}
        <div class="cs-progress-{{ section_id }}" data-cs-progress aria-hidden="true">
          <div class="cs-progress__bar" data-cs-progress-bar></div>
        </div>

      </div>

    </div>
  </div>

</section>

{%- comment -%} ━━━━━━━━━━━━━━━━━━ JS ━━━━━━━━━━━━━━━━━━ {%- endcomment -%}
<script>
  (function () {
    'use strict';

    class CategorySlider {
      constructor(section) {
        this.section = section;
        this.track = section.querySelector('[data-cs-track]');
        this.prevBtn = section.querySelector('[data-cs-prev]');
        this.nextBtn = section.querySelector('[data-cs-next]');
        this.progressBar = section.querySelector('[data-cs-progress-bar]');
        this.linear = section.querySelector('[data-cs-linear]');

        if (!this.track) return;

        this._onScroll = this._onScroll.bind(this);
        this._onPointerDown = this._onPointerDown.bind(this);
        this._onPointerMove = this._onPointerMove.bind(this);
        this._onPointerUp = this._onPointerUp.bind(this);
        this._onKeyDown = this._onKeyDown.bind(this);
        this._blockClick = this._blockClick.bind(this);

        this._dragging = false;
        this._startX = 0;
        this._scrollLeft = 0;

        this._init();
      }

      _init() {
        /* Measure linear text width and set as track left-padding */
        this._setLinearWidth();
        window.addEventListener('resize', () => this._setLinearWidth());

        this.track.addEventListener('scroll', this._onScroll, { passive: true });
        if (this.prevBtn) this.prevBtn.addEventListener('click', () => this._scroll(-1));
        if (this.nextBtn) this.nextBtn.addEventListener('click', () => this._scroll(1));
        this.track.addEventListener('pointerdown', this._onPointerDown);
        this.track.addEventListener('keydown', this._onKeyDown);
        /* Prevent native image drag from hijacking pointer */
        this.track.addEventListener('dragstart', function (e) { e.preventDefault(); });
        this._onScroll();
      }

      _setLinearWidth() {
        var linear = this.section.querySelector('[data-cs-linear]');
        if (linear) {
          var w = linear.offsetWidth;
          this.section.style.setProperty('--cs-linear-width', w + 'px');
        }
      }

      _getSlideWidth() {
        const slide = this.track.querySelector('.cs-slide');
        if (!slide) return 300;
        const gap = parseFloat(getComputedStyle(this.track).gap) || 0;
        return slide.offsetWidth + gap;
      }

      _scroll(direction) {
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        this.track.scrollBy({
          left: direction * this._getSlideWidth(),
          behavior: reducedMotion ? 'auto' : 'smooth'
        });
      }

      _onScroll() {
        const { scrollLeft, scrollWidth, clientWidth } = this.track;
        const maxScroll = scrollWidth - clientWidth;
        if (this.prevBtn) this.prevBtn.disabled = scrollLeft <= 2;
        if (this.nextBtn) this.nextBtn.disabled = scrollLeft >= maxScroll - 2;
        if (this.progressBar && maxScroll > 0) {
          const pct = Math.min((scrollLeft / maxScroll) * 100, 100);
          this.progressBar.style.width = pct + '%';
        }
        /* Push linear text away as cards scroll over it */
        if (this.linear) {
          var linearW = this.linear.offsetWidth;
          /* Only push once scroll eats into the linear area */
          var push = Math.min(scrollLeft, linearW);
          this.linear.style.transform = 'translateX(' + (-push) + 'px)';
          /* Fade out as it gets pushed */
          var opacity = Math.max(1 - (push / linearW), 0);
          this.linear.style.opacity = opacity;
        }
      }

      _onPointerDown(e) {
        if (e.pointerType === 'touch') return;
        this._dragging = false;
        this._didDrag = false;
        this._startX = e.pageX;
        this._scrollLeft = this.track.scrollLeft;
        this._pointerId = e.pointerId;
        this.track.addEventListener('pointermove', this._onPointerMove);
        this.track.addEventListener('pointerup', this._onPointerUp);
        this.track.addEventListener('pointercancel', this._onPointerUp);
      }

      _onPointerMove(e) {
        const delta = Math.abs(e.pageX - this._startX);
        /* Only start drag after 5px movement — lets clicks pass through */
        if (!this._dragging) {
          if (delta < 5) return;
          this._dragging = true;
          this._didDrag = true;
          this.track.classList.add('cs-track--grabbing');
          this.track.setPointerCapture(this._pointerId);
        }
        e.preventDefault();
        this.track.scrollLeft = this._scrollLeft - (e.pageX - this._startX);
      }

      _onPointerUp(e) {
        /* If we actually dragged, prevent the click from navigating */
        if (this._didDrag) {
          this.track.addEventListener('click', this._blockClick, { once: true, capture: true });
        }
        this._dragging = false;
        this._didDrag = false;
        this.track.classList.remove('cs-track--grabbing');
        try { this.track.releasePointerCapture(e.pointerId); } catch (_) {}
        this.track.removeEventListener('pointermove', this._onPointerMove);
        this.track.removeEventListener('pointerup', this._onPointerUp);
        this.track.removeEventListener('pointercancel', this._onPointerUp);
      }

      _blockClick(e) {
        e.preventDefault();
        e.stopPropagation();
      }

      _onKeyDown(e) {
        if (e.key === 'ArrowRight') { e.preventDefault(); this._scroll(1); }
        if (e.key === 'ArrowLeft')  { e.preventDefault(); this._scroll(-1); }
      }
    }

    function init() {
      document.querySelectorAll('[data-section-type="category-slider"]').forEach(function (el) {
        if (!el._csInit) {
          new CategorySlider(el);
          el._csInit = true;
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }

    document.addEventListener('shopify:section:load', function (e) {
      var section = e.target.querySelector('[data-section-type="category-slider"]');
      if (section) {
        section._csInit = false;
        new CategorySlider(section);
        section._csInit = true;
      }
    });
  })();
</script>

