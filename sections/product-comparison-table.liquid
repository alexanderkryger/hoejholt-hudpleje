    { "type": "text", "id": "product_title_4", "label": "Produkt 4 titel override" },
    { "type": "product", "id": "product_5", "label": "Produkt 5" },
    { "type": "text", "id": "product_title_5", "label": "Produkt 5 titel override" },
    { "type": "product", "id": "product_6", "label": "Produkt 6" },
    { "type": "text", "id": "product_title_6", "label": "Produkt 6 titel override" },
